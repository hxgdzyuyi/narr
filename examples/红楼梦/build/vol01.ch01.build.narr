    ordered_beats: [
      红楼梦.structure.作者自陈本旨,
      红楼梦.structure.女娲炼石遗石,
      红楼梦.structure.僧道携石入世,
      红楼梦.structure.空空道人抄录石记,
      红楼梦.structure.甄士隐梦见太虚,
      红楼梦.structure.僧道警示英莲,
      红楼梦.structure.士隐雨村交谈,
      红楼梦.structure.雨村窥见娇杏,
      红楼梦.structure.中秋资助雨村,
      红楼梦.structure.英莲元宵失踪,
      红楼梦.structure.葫芦庙失火,
      红楼梦.structure.士隐投奔封肃,
      红楼梦.structure.士隐听好了歌,
      红楼梦.structure.雨村到任传唤,
    ]
    beat_preconditions: [
      { beat: 红楼梦.structure.僧道携石入世, condition: "chars.通灵宝玉.状态 == 未用" },
      { beat: 红楼梦.structure.雨村窥见娇杏, condition: "chars.贾雨村.状态 == 困居葫芦庙" },
      { beat: 红楼梦.structure.中秋资助雨村, condition: "chars.贾雨村.状态 == 困居葫芦庙" },
      { beat: 红楼梦.structure.士隐听好了歌, condition: "chars.甄士隐.状态 == 寄居困顿" },
    ]
    beat_effects: [
      {
        beat: 红楼梦.structure.作者自陈本旨
        effect:
          chars.叙述者.知道 += world.作者自陈本旨
      },
      {
        beat: 红楼梦.structure.女娲炼石遗石
        effect:
          chars.通灵宝玉.位置 = world.青埂峰
          chars.通灵宝玉.状态 = 未用
      },
      {
        beat: 红楼梦.structure.僧道携石入世
        effect:
          chars.通灵宝玉.身份 = 通灵宝玉
          chars.通灵宝玉.状态 = 美玉
          chars.通灵宝玉.位置 = world.红尘入口
          chars.茫茫大士.知道 += world.通灵宝玉源起
          chars.渺渺真人.知道 += world.通灵宝玉源起
      },
      {
        beat: 红楼梦.structure.空空道人抄录石记
        effect:
          chars.空空道人.知道 += world.石头记成书
          chars.空空道人.身份 = 情僧
          chars.曹雪芹.知道 += world.石头记成书
      },
      {
        beat: 红楼梦.structure.甄士隐梦见太虚
        effect:
          chars.甄士隐.位置 = world.太虚幻境
          chars.甄士隐.知道 += world.还泪因果
          chars.甄士隐.心境 = 惊异
          chars.甄士隐.arc_state = 惊异
      },
      {
        beat: 红楼梦.structure.僧道警示英莲
        effect:
          chars.英莲.状态 = 被预言
          chars.英莲.arc_state = 被预言
          chars.甄士隐.知道 += world.英莲劫数
      },
      {
        beat: 红楼梦.structure.士隐雨村交谈
        effect:
          chars.贾雨村.位置 = world.甄府
          chars.甄士隐.知道 += world.贾雨村贫困
          chars.贾雨村.关系 += 与甄士隐相交
      },
      {
        beat: 红楼梦.structure.雨村窥见娇杏
        effect:
          chars.贾雨村.心境 = 自许知己
          chars.贾雨村.相信 += 娇杏回顾是知己之意
          chars.娇杏.知道 += world.贾雨村贫困
          chars.娇杏.arc_state = 偶顾
      },
      {
        beat: 红楼梦.structure.中秋资助雨村
        effect:
          chars.贾雨村.状态 = 得资入都
          chars.贾雨村.位置 = world.神都
          chars.贾雨村.arc_state = 起势
          chars.甄士隐.关系 += 资助贾雨村赴考
          chars.贾雨村.知道 += world.士隐资助雨村
      },
      {
        beat: 红楼梦.structure.英莲元宵失踪
        effect:
          chars.英莲.状态 = 失踪
          chars.英莲.位置 = world.未明
          chars.英莲.arc_state = 失踪
          chars.霍启.状态 = 逃走
          chars.甄士隐.心境 = 哀痛
          chars.封氏.心境 = 哀痛
      },
      {
        beat: 红楼梦.structure.葫芦庙失火
        effect:
          world.葫芦庙.状态 = 起火
          world.甄府.状态 = 焚毁
          chars.甄士隐.状态 = 破家
          chars.封氏.状态 = 破家
      },
      {
        beat: 红楼梦.structure.士隐投奔封肃
        effect:
          chars.甄士隐.位置 = world.封肃家
