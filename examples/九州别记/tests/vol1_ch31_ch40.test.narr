namespace 九州别记.tests

import 九州别记.structure as structure
import 九州别记.characters as chars
import 九州别记.world as world
import 九州别记.threads as threads

test "第三十一至四十章接续梦醒现实反压段" tags {structure, vol01, chapters} {
  assert previous(structure.vol01.ch31) == structure.vol01.ch30
  assert next(structure.vol01.ch40) == structure.vol01.ch41
  assert count(beat 节拍 in beats(structure.vol01.ch31)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch40)) == 5
}

test "梦印反写后四方意识到残片价值" tags {state, dream, pressure} {
  assert structure.vol01.ch31 advances threads.殇阳梦境线
  assert structure.vol01.ch31 advances threads.大墓真相线
  assert state(world.殇阳梦境残印.状态, at structure.vol01.ch31.end) == 反写现实
  assert state(world.离公墓志残片.状态, at structure.vol01.ch31.end) == 四方争值
  assert state(chars.牧云烬.状态, at structure.vol01.ch31.end) == 估出残片价值
  assert state(chars.丁缺金.状态, at structure.vol01.ch35.end) == 再次背门
}

test "现实侧围困与内斗逐章加压" tags {state, conflict, politics} {
  assert structure.vol01.ch32 advances threads.端朝皇权线
  assert structure.vol01.ch33 advances threads.辰月暗流线
  assert structure.vol01.ch34 advances threads.天驱旧誓线
  assert structure.vol01.ch39 advances threads.端朝皇权线
  assert state(world.墓志石室.状态, at structure.vol01.ch32.end) == 围困加压
  assert state(world.星文回廊.状态, at structure.vol01.ch33.end) == 封锁失效
  assert state(chars.姬断鹰.状态, at structure.vol01.ch34.end) == 夺誓索证
  assert state(chars.丁缺金.状态, at structure.vol01.ch40.end) == 被辰月弃用
}

test "主角团优先守活人与证据" tags {state, door_rule, evidence} {
  assert structure.vol01.ch37 advances threads.摸金门规线
  assert structure.vol01.ch37 advances threads.九州野史线
  assert state(chars.穆如砚.状态, at structure.vol01.ch37.end) == 护民护证
  assert state(world.殇阳关战牍.状态, at structure.vol01.ch37.end) == 分录护证
  assert state(world.离公墓志残片.状态, at structure.vol01.ch37.end) == 分藏护证
}

test "断铭和军制证据只推进到出土未证" tags {state, reveal, tomb} {
  assert structure.vol01.ch36 reveals world.离国军工痕迹
  assert structure.vol01.ch36 reveals world.嬴无翳用人与军政
  assert structure.vol01.ch40 reveals world.嬴无翳骑射霸刀
  assert structure.vol01.ch40 reveals world.嬴无翳用人与军政
  assert state(world.离国马具残饰.状态, at structure.vol01.ch36.end) == 军制入证
  assert state(world.霸刀断铭.状态, at structure.vol01.ch40.end) == 出土未证
  assert state(world.疑似离公墓域.状态, at structure.vol01.ch40.end) == 主墓将明
  assert state(chars.牧云烬.状态, at structure.vol01.ch40.end) == 封口夺证
}
