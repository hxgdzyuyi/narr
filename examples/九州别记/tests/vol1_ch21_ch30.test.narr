namespace 九州别记.tests

import 九州别记.structure as structure
import 九州别记.characters as chars
import 九州别记.world as world
import 九州别记.threads as threads

test "第二十一至三十章承接梦境第二段" tags {structure, vol01, chapters} {
  assert previous(structure.vol01.ch21) == structure.vol01.ch20
  assert next(structure.vol01.ch30) == structure.vol01.ch31
  assert count(beat 节拍 in beats(structure.vol01.ch21)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch22)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch23)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch24)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch25)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch26)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch27)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch28)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch29)) == 5
  assert count(beat 节拍 in beats(structure.vol01.ch30)) == 5
}

test "梦境第二段继续归名而不改写败局" tags {dream, boundary, 殇阳关} {
  assert structure.vol01.ch21 reveals world.殇阳关战役事实
  assert structure.vol01.ch22 reveals world.殇阳关异变之夜
  assert structure.vol01.ch23 reveals world.雷碧城辰月国师
  assert structure.vol01.ch24 reveals world.张博殇阳战死
  assert structure.vol01.ch26 reveals world.墓主遗憾核心
  assert structure.vol01.ch27 reveals world.梦境挽回边界
  assert state(world.梦中殇阳雨阵.状态, at structure.vol01.ch29.end) == 突围因果已闭
  assert state(world.梦中殇阳雨阵.状态, at structure.vol01.ch29.end) != 战役改写
}

test "无名战牍由残缺走向群名初成" tags {state, names, battle_document} {
  assert state(world.无名战牍残页.状态, at structure.vol01.ch21.end) == 残页再启
  assert state(world.雷碧城星术残简.状态, at structure.vol01.ch22.end) == 污染显形
  assert state(world.张博断刃.状态, at structure.vol01.ch24.end) == 群名残缺
  assert state(world.无名战牍残页.状态, at structure.vol01.ch30.end) == 群名初成
  assert state(world.殇阳梦境残印.状态, at structure.vol01.ch30.end) == 群名反写
}

test "第二十一至三十章持续推进殇阳与墓主真相" tags {threads, pacing} {
  assert structure.vol01.ch21 advances threads.殇阳梦境线
  assert structure.vol01.ch22 advances threads.辰月暗流线
  assert structure.vol01.ch23 advances threads.九州野史线
  assert structure.vol01.ch24 advances threads.殇阳梦境线
  assert structure.vol01.ch25 advances threads.摸金门规线
  assert structure.vol01.ch26 advances threads.九州野史线
  assert structure.vol01.ch27 advances threads.大墓真相线
  assert structure.vol01.ch28 advances threads.天驱旧誓线
  assert structure.vol01.ch29 advances threads.殇阳梦境线
  assert structure.vol01.ch30 advances threads.大墓真相线
}

test "第三十章退潮回到墓志石室但不完全公开墓主" tags {state, dream, tomb} {
  assert state(world.殇阳关梦境.状态, at structure.vol01.ch30.end) == 初步退潮
  assert state(chars.殷折.位置, at structure.vol01.ch30.end) == world.墓志石室
  assert state(chars.殷折.状态, at structure.vol01.ch30.end) == 带群名醒转
  assert state(world.嬴无翳.状态, at structure.vol01.ch30.end) == 墓主仍未全明
}
