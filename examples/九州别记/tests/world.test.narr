namespace 九州别记.tests

import 九州别记.world as world

test "燮朝与端朝世界观事实已建立" tags {world, dynasty} {
  assert world.燮朝承胤末 exists
  assert world.姬昌夜承帝统 exists
  assert world.端朝承晟末 exists
  assert world.牧云穆如盟约 exists
  assert world.端末盟约破裂 exists
  assert world.九州别记朝代用法 exists
}

test "两朝关键势力已建立" tags {world, faction} {
  assert world.燮朝 exists
  assert world.燮室姬氏 exists
  assert world.离国 exists
  assert world.离国赤旅 exists
  assert world.端朝 exists
  assert world.端室牧云氏 exists
  assert world.穆如军门 exists
  assert world.瀚州硕风部 exists
}

