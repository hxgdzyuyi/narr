test "朝代世界观保持开局未知大墓" tags {world, premise} {
  assert world.开局不知大墓 exists
  assert world.地理约束原则 exists
  assert world.地上地下双线地理 exists
  assert world.疑似封陵.状态 == 身份未明
  assert world.疑似离公墓域.状态 == 未证实
}

test "嬴无翳墓主世界观已建立" tags {world, 嬴无翳, tomb} {
  assert world.嬴无翳 exists
  assert world.嬴无翳为离公 exists
  assert world.嬴无翳善兵 exists
  assert world.嬴无翳未帝而霸 exists
  assert world.嬴无翳弑兄继位 exists
  assert world.嬴无翳骑射霸刀 exists
  assert world.嬴无翳用人与军政 exists
  assert world.嬴无翳乡下诸侯自嘲 exists
  assert world.离国辰月牵连 exists
  assert world.雷碧城辰月国师 exists
  assert world.殇阳关战役事实 exists
  assert world.殇阳关异变之夜 exists
  assert world.嬴无翳墓葬危险原则 exists
  assert world.张博殇阳战死 exists
  assert world.殇阳梦境映射机制 exists
  assert world.化身墓主规则 exists
  assert world.墓主遗憾核心 exists
  assert world.梦境挽回边界 exists
  assert world.殇阳梦境卷级用法 exists
  assert world.嬴无翳墓主定位 exists
  assert world.霸刀遗名 exists
  assert world.霸刀断铭 exists
  assert world.离国马具残饰 exists
  assert world.殇阳关战牍 exists
  assert world.雷碧城星术残简 exists
  assert world.雷碧城 exists
  assert world.白毅 exists
  assert world.张博 exists
  assert world.离国国师府 exists
  assert world.离国铁骑 exists
  assert world.雷碧城辰月支 exists
  assert world.殇阳关联军 exists
  assert world.离公墓志残片 exists
  assert world.殇阳关梦境 exists
  assert world.梦中殇阳雨阵 exists
  assert world.殇阳梦境残印 exists
  assert world.张博断刃 exists
  assert world.无名战牍残页 exists
  assert world.嬴无翳.所属 == world.离国
  assert world.嬴无翳.状态 == 墓主待证
  assert world.雷碧城.所属 == world.雷碧城辰月支
  assert world.白毅.所属 == world.楚卫国
  assert world.张博.所属 == world.离国铁骑
}

