test "地下遗迹纳入多族痕迹但仍不确认墓主" tags {world, tomb, races} {
  assert count(facts) >= 70
  assert count(objects) >= 14
  assert world.河络地火机坊 exists
  assert world.羽族坠羽井 exists
  assert world.鲛泪暗渠 exists
  assert world.星文回廊 exists
  assert world.夸父骨画壁 exists
  assert world.魅影空廊 exists
  assert world.河络机坊封死事实 exists
  assert world.鲛泪暗渠事实 exists
  assert world.夸父骨画壁事实 exists
  assert world.魅影空廊事实 exists
  assert world.疑似离公墓域.状态 == 未证实
  assert world.嬴无翳.状态 == 墓主待证
}
