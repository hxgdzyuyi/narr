namespace 九州别记.tests

import 九州别记.structure as structure
import 九州别记.promises as promises

test "开局 promise 已建立" tags {promise, structure} {
  assert count(promises) >= 12

  assert promises.祖辈封门伏笔.setup_strength == strong
  assert promises.殷门罗盘伏笔.setup_strength == strong
  assert promises.燮朝重封伏笔.setup_strength == strong
  assert promises.石门身份伏笔.reader_visibility == visible
}

test "所有 promise 保留基础构件" tags {promise, schema} {
  forall promise 伏笔 in promises:
    assert 伏笔.setup_at exists
    assert 伏笔.setup_strength exists
    assert 伏笔.question exists
    assert 伏笔.reader_visibility exists
    assert 伏笔.note exists
}

test "可见 promise 由 setup 所在章承载" tags {promise, visibility} {
  forall promise 伏笔 where 伏笔.reader_visibility == visible:
    exists chapter 章节 where chapter_of(伏笔.setup_at) == 章节:
      assert 章节 serves 伏笔
}

test "前三章显式设置与兑现 promise" tags {promise, chapters} {
  let 第一章 = structure.vol01.ch01
  let 第二章 = structure.vol01.ch02
  let 第三章 = structure.vol01.ch03

  assert 第一章 sets_up promises.祖辈封门伏笔
  assert 第一章 pays_off promises.祖辈封门伏笔
  assert 第一章 sets_up promises.殷门罗盘伏笔
  assert 第二章 pays_off promises.殷门罗盘伏笔
  assert 第二章 sets_up promises.机关残学伏笔
  assert 第三章 pays_off promises.机关残学伏笔
  assert 第三章 sets_up promises.塌陷原因悬念
  assert 第三章 pays_off promises.塌陷原因悬念
  assert 第三章 sets_up promises.石门身份伏笔
}

test "前三章 promise 服务节奏先铺后启" tags {promise, pacing} {
  assert count(served_promises(structure.vol01.ch01)) >= 2
  assert count(served_promises(structure.vol01.ch02)) >= 5
  assert count(served_promises(structure.vol01.ch03)) >= 7
}

test "promise 不把开局写成已知大墓" tags {promise, premise} {
  assert count(promise 伏笔 in promises where 伏笔.question == "开局已知目标是嬴无翳大墓") == 0
  assert count(promise 伏笔 in promises where 伏笔.note == "开局已知目标是嬴无翳大墓") == 0
  assert count(promise 伏笔 in promises where 伏笔.note == "已知目标是嬴无翳大墓") == 0
}
