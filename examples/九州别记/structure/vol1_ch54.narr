namespace 九州别记.structure.vol1_ch54

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 穆如旧令对密诏 @ structure.vol01.ch54 {
  effect:
    chars.穆如砚.位置 = world.雪炽原旧驿
    chars.穆如砚.状态 = 对读旧令密诏
    world.穆如旧令抄本.状态 = 与密诏相冲

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜 }
  advances: { threads.穆如军门线, threads.端朝皇权线 }
  mentions: { world.穆如旧令抄本, world.牧云掩史旧档, world.雪炽原旧驿 }
  render_hint: "从旧令与密诏的文字冲突切入，不直接靠人物猜测。"
}

beat 双诏矛盾露出 @ structure.vol01.ch54 {
  effect:
    chars.穆如砚.知道 += world.端末盟约破裂
    chars.牧云镜.知道 += world.牧云穆如盟约
    world.端朝.状态 = 双诏互裂

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜 }
  advances: { threads.端朝皇权线, threads.穆如军门线 }
  reveals: { world.端末盟约破裂, world.牧云穆如盟约 }
  mentions: { world.端朝, world.端室牧云氏, world.穆如军门 }
  render_hint: "矛盾要指向盟约破裂，而不是单个官员弄错命令。"
}

beat 牧云镜交出副诏 @ structure.vol01.ch54 {
  effect:
    chars.牧云镜.位置 = world.雪炽原旧驿
    chars.牧云镜.状态 = 交出副诏
    chars.穆如砚.关系 += "接过牧云镜藏下的副诏"

  pov: chars.牧云镜
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云镜, chars.穆如砚, chars.殷折 }
  advances: { threads.九州野史线, threads.穆如军门线 }
  mentions: { world.牧云掩史旧档, world.穆如旧令抄本, world.端朝掩史司 }
  render_hint: "牧云镜把副诏交给穆如砚，是两人互信的实际转折。"
}

beat 穆如砚知诏害民 @ structure.vol01.ch54 {
  effect:
    chars.穆如砚.状态 = 知诏害民
    chars.穆如砚.arc_state = 护民疑诏
    chars.穆如砚.相信 += "继续奉诏会先害边民和军户"
    world.穆如旧令抄本.状态 = 迁民待决

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜 }
  advances: { threads.穆如军门线, threads.端朝皇权线 }
  mentions: { world.雪炽原旧驿, world.殇州流放道, world.穆如军门 }
  render_hint: "穆如砚的判断来自护民后果，而不是只为私人义气。"
}

beat 军门密诏反成罪证 @ structure.vol01.ch54 {
  effect:
    world.穆如军门.状态 = 密诏反证
    world.端室牧云氏.状态 = 盟约裂证
    chars.穆如砚.知道 += world.端末盟约破裂

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.殷折 }
  pays_off: promises.军门密诏悬念
  advances: { threads.穆如军门线, threads.端朝皇权线, threads.九州野史线 }
  reveals: world.端末盟约破裂
  mentions: { world.穆如旧令抄本, world.牧云穆如盟约, world.端末东西分裂 }
  render_hint: "兑现方式是密诏反证端朝裂局，保留更高层朝争悬念。"
}
