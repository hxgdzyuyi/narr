beat 崩道逼回石室 @ structure.vol01.ch37 {
  effect:
    chars.殷折.位置 = world.墓志石室
    chars.牧云镜.位置 = world.墓志石室
    chars.穆如砚.位置 = world.墓志石室
    chars.苏离灯.位置 = world.墓志石室
    world.赤旅兵冢.状态 = 塌道逼退
    world.墓志石室.状态 = 塌道回护

  pov: chars.穆如砚
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.穆如砚, chars.殷折, chars.牧云镜, chars.苏离灯 }
  advances: { threads.误入地宫线, threads.穆如军门线 }
  mentions: { world.赤旅兵冢, world.墓志石室, world.疑似离公墓域 }
  render_hint: "崩道逼回石室要形成护证压力，而不是简单重复迷路。"
}

beat 穆如砚护民护证 @ structure.vol01.ch37 {
  effect:
    chars.穆如砚.状态 = 护民护证
    chars.穆如砚.关系 += "把伤者和原证都列入军门护送范围"
    world.穆如军门.状态 = 护证违令

  pov: chars.穆如砚
  location: world.墓志石室
  on_screen: true
  observers: { chars.穆如砚, chars.殷折, chars.牧云镜, chars.牧云烬 }
  advances: { threads.穆如军门线, threads.摸金门规线, threads.端朝皇权线 }
  mentions: { world.穆如军门, world.穆如旧令抄本, world.端朝掩史司 }
  render_hint: "护民护证要让穆如砚同时背负军令和人命，不写成轻松倒戈。"
}

beat 牧云镜分录证词 @ structure.vol01.ch37 {
  effect:
    chars.牧云镜.状态 = 分录证词
    chars.牧云镜.相信 += "证词必须分存才不会被一纸密诏抹掉"
    world.殇阳关战牍.状态 = 分录护证

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.九州野史线, threads.封陵旧史线, threads.端朝皇权线 }
  mentions: { world.殇阳关战牍, world.牧云掩史旧档, world.掩史司密库 }
  render_hint: "分录证词不是完成写史，而是避免原证被夺后无人能作证。"
}

beat 硕风照夜听出外围 @ structure.vol01.ch37 {
  effect:
    chars.硕风照夜.位置 = world.墓志石室
    chars.硕风照夜.状态 = 听出外围
    chars.硕风照夜.知道 += world.地上地下双线地理
    world.无名旧道.状态 = 外困成围

  pov: chars.硕风照夜
  location: world.墓志石室
  on_screen: true
  observers: { chars.硕风照夜, chars.殷折, chars.穆如砚 }
  advances: { threads.瀚州草原线, threads.误入地宫线 }
  mentions: { world.无名旧道, world.雪炽原, world.地上地下双线地理 }
  render_hint: "照夜听出的外围压力要把地上围困重新接回地下行动。"
}

beat 殷折把证据分藏 @ structure.vol01.ch37 {
  effect:
    chars.殷折.状态 = 分藏护证
    chars.殷折.arc_state = 守证救人
