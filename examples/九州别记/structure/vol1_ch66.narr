namespace 九州别记.structure.vol1_ch66

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 梦印反潮入阵 @ structure.vol01.ch66 {
  effect:
    world.殇阳梦境残印.状态 = 反潮入阵
    world.殇阳关梦境.状态 = 残印反照
    chars.殷折.位置 = world.殇阳关梦境

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.大墓真相线 }
  mentions: { world.殇阳梦境残印, world.殇阳关梦境, world.墓志石室 }
  render_hint: "梦印反潮要有被外部星局撕扯的感觉。"
}

beat 张博归名照出边界 @ structure.vol01.ch66 {
  effect:
    world.张博断刃.状态 = 归名再照
    world.无名战牍残页.状态 = 归名边界显现
    chars.殷折.知道 += world.梦境挽回边界

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.九州野史线 }
  reveals: world.梦境挽回边界
  mentions: { world.张博断刃, world.无名战牍残页, world.张博殇阳战死 }
  render_hint: "张博归名应成为边界证据，不重复第二十章的完整情感兑现。"
}

beat 雷碧城旧术露出污源 @ structure.vol01.ch66 {
  effect:
    world.雷碧城星术残简.状态 = 露出污源
    world.雷碧城.状态 = 旧术污源显影
    chars.殷折.知道 += world.雷碧城辰月国师

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.辰月暗流线, threads.殇阳梦境线 }
  reveals: { world.雷碧城辰月国师, world.殇阳关异变之夜 }
  mentions: { world.雷碧城, world.雷碧城星术残简, world.雷碧城辰月支 }
  render_hint: "雷碧城旧术要作为污染来源显影，不把梦境变成辰月单方控制。"
}

beat 天驱破局传闻被星局借用 @ structure.vol01.ch66 {
  effect:
    world.旧鹰扳指.状态 = 被梦印牵入破局传闻
    chars.苏离灯.知道 += world.殇阳关异变之夜
    chars.苏离灯.状态 = 辨认破局传闻

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.姬断鹰 }
  advances: { threads.天驱旧誓线, threads.殇阳梦境线, threads.辰月暗流线 }
  reveals: world.殇阳关异变之夜
  mentions: { world.旧鹰扳指, world.天驱旧盟, world.十二主星盘 }
  render_hint: "天驱破局传闻要被写成被星局借用的材料，而不是确定史实全貌。"
}

beat 殷折守住梦境边界 @ structure.vol01.ch66 {
  effect:
    chars.殷折.状态 = 守住梦境边界
    chars.殷折.arc_state = 守规留史
    world.殇阳梦境残印.状态 = 边界未被夺用

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.摸金门规线, threads.大墓真相线 }
  reveals: { world.墓主遗憾核心, world.梦境挽回边界 }
  mentions: { world.殇阳梦境残印, world.嬴无翳, world.张博 }
  render_hint: "殷折守住的是不让梦境被拿去改史，不是关闭梦境。"
}
