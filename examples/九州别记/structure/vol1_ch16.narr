namespace 九州别记.structure.vol1_ch16

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 铁誓厅旁暗门开启 @ structure.vol01.ch16 {
  effect:
    chars.苏离灯.位置 = world.星文回廊
    chars.殷折.位置 = world.星文回廊
    chars.牧云镜.位置 = world.星文回廊
    chars.洛衡.位置 = world.星文回廊
    world.星文回廊.状态 = 暗门开启

  pov: chars.苏离灯
  location: world.星文回廊
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜, chars.洛衡 }
  advances: { threads.天驱旧誓线, threads.误入地宫线 }
  mentions: { world.地下铁誓厅, world.星文回廊 }
  render_hint: "星文回廊从铁誓厅侧面显出，承接天驱线而不是取代天驱线。"
}

beat 雷碧城残简现星 @ structure.vol01.ch16 {
  effect:
    chars.苏离灯.状态 = 见残简星纹
    chars.牧云镜.知道 += world.雷碧城辰月国师
    chars.牧云镜.知道 += world.星文回廊事实
    world.雷碧城星术残简.状态 = 星纹显现
    world.星文回廊.状态 = 残简显现

  pov: chars.牧云镜
  location: world.星文回廊
  on_screen: true
  observers: { chars.牧云镜, chars.苏离灯, chars.殷折 }
  sets_up: promises.星术触梦伏笔
  advances: { threads.封陵旧史线, threads.辰月暗流线, threads.大墓真相线 }
  reveals: world.星文回廊事实
  mentions: { world.雷碧城星术残简, world.雷碧城, world.辰月暗宗 }
  render_hint: "残简说明辰月污染证据链，但不能让星术直接给出答案。"
}

beat 闻人远催星盘 @ structure.vol01.ch16 {
  effect:
    chars.闻人观星.状态 = 远催星盘
    chars.闻人观星.知道 += world.十二主星秘术体系
    world.十二主星盘.状态 = 遥应回廊

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  mentions: { world.十二主星盘, world.辰月星坛, world.星文回廊 }
  render_hint: "闻人只能远程推动误读和回路，不要写成隔空全知。"
}

beat 苏离灯识出誓术污染 @ structure.vol01.ch16 {
  effect:
    chars.苏离灯.状态 = 识出誓术污染
    chars.苏离灯.知道 += world.辰月主星偏用
    chars.苏离灯.相信 += "旧誓被星术借用过"
    world.旧鹰扳指.状态 = 裂纹照星

  pov: chars.苏离灯
  location: world.星文回廊
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜 }
  advances: { threads.天驱旧誓线, threads.辰月暗流线 }
  mentions: { world.旧鹰扳指, world.星文回廊, world.雷碧城星术残简 }
  render_hint: "苏离灯辨出污染，不把天驱旧誓和辰月秘术混成一件事。"
}

beat 殷折残片应星 @ structure.vol01.ch16 {
  effect:
    chars.殷折.状态 = 残片应星
    chars.殷折.知道 += world.殇阳梦境映射机制
    world.离公墓志残片.状态 = 应星发热
    world.雷碧城星术残简.状态 = 与残片互照
    world.星文回廊.状态 = 残简照片

  pov: chars.殷折
  location: world.星文回廊
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜 }
  advances: { threads.大墓真相线, threads.殇阳梦境线, threads.摸金门规线 }
  mentions: { world.离公墓志残片, world.雷碧城星术残简, world.殇阳关梦境 }
  render_hint: "残片只显示触梦可能，梦境还不能在本章完全打开。"
}
