import 九州别记.threads as threads
import 九州别记.promises as promises

beat 丁缺金领错兵冢岔路 @ structure.vol01.ch35 {
  effect:
    chars.丁缺金.位置 = world.赤旅兵冢
    chars.殷折.位置 = world.赤旅兵冢
    chars.牧云镜.位置 = world.赤旅兵冢
    chars.穆如砚.位置 = world.赤旅兵冢
    chars.苏离灯.位置 = world.赤旅兵冢
    chars.丁缺金.状态 = 领错岔路
    world.赤旅兵冢.状态 = 错岔再开

  pov: chars.丁缺金
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.丁缺金, chars.殷折, chars.牧云镜, chars.穆如砚 }
  advances: { threads.摸金门规线, threads.误入地宫线 }
  mentions: { world.赤旅兵冢, world.疑似离公墓域, world.丁缺金门规旧债 }
  render_hint: "丁缺金领错路要保留摸金技术的真实感，让背叛藏在熟门熟路里。"
}

beat 闻人以星令弃子 @ structure.vol01.ch35 {
  effect:
    chars.闻人观星.位置 = world.辰月星坛
    chars.闻人观星.状态 = 弃子控局
    chars.丁缺金.状态 = 被星令试弃
    chars.丁缺金.知道 += world.辰月人物规划原则
    world.十二主星盘.状态 = 弃子星令

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  advances: { threads.辰月暗流线, threads.摸金门规线 }
  mentions: { world.十二主星盘, world.辰月暗宗, world.赤旅兵冢 }
  render_hint: "辰月弃子是远程操盘的结果，不要让闻人亲自下场解释所有计划。"
}

beat 丁缺金再次背门 @ structure.vol01.ch35 {
  effect:
    chars.丁缺金.状态 = 再次背门
    chars.丁缺金.关系 += "把殷门退路再次卖给外人"
    world.离公墓志残片.状态 = 被背门盯上
    world.殷门罗盘.状态 = 背门再窥

  pov: chars.丁缺金
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.丁缺金, chars.殷折 }
  advances: { threads.摸金门规线, threads.辰月暗流线 }
  mentions: { world.离公墓志残片, world.殷门罗盘, world.摸金殷门 }
  render_hint: "再次背门要写成他恐惧被弃后更急着卖路，不写成忽然强大。"
}

beat 殷折先救伤者 @ structure.vol01.ch35 {
  effect:
    chars.殷折.状态 = 先救伤者
    chars.殷折.arc_state = 守规救人
    chars.穆如砚.关系 += "见殷折先救伤者而暂缓夺证"
    world.赤旅兵冢.状态 = 塌陷逼救

  pov: chars.殷折
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.殷折, chars.穆如砚, chars.牧云镜, chars.丁缺金 }
  advances: { threads.摸金门规线, threads.穆如军门线 }
  mentions: { world.赤旅兵冢, world.殷门祖辈传承, world.摸金殷门 }
  render_hint: "殷折此处必须先救人，门规选择压过追杀丁缺金。"
}

beat 兵冢深处露出军列 @ structure.vol01.ch35 {
  effect:
    world.赤旅兵冢.状态 = 军列初露
    world.离国马具残饰.状态 = 军列映出
    world.离国赤旅.状态 = 军列待辨

  pov: chars.洛衡
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.洛衡, chars.殷折, chars.牧云镜 }
  advances: { threads.大墓真相线, threads.九州野史线 }
  mentions: { world.赤旅兵冢, world.离国马具残饰, world.离国赤旅 }
  render_hint: "章末只露出军列和制式问题，把完整辨证留给下一章。"
}
