beat 苏离灯收回誓名 @ structure.vol01.ch68 {
  effect:
    chars.苏离灯.状态 = 收回誓名
    chars.苏离灯.arc_state = 守誓自定
    world.旧鹰扳指.状态 = 誓名收回

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.姬断鹰 }
  advances: threads.天驱旧誓线
  reveals: world.天驱人物规划原则
  mentions: { world.旧鹰扳指, world.天驱护陵旧誓, world.天驱旧盟 }
  render_hint: "收回誓名不是继承宗主，而是拒绝让夺权者替旧誓命名。"
}

beat 旧鹰扳指转为自鸣 @ structure.vol01.ch68 {
  effect:
    world.旧鹰扳指.状态 = 自定守誓
    chars.苏离灯.相信 += "旧誓只能由当下守护之事校验。"
    world.地下铁誓厅.状态 = 自定守誓回声

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  mentions: { world.旧鹰扳指, world.地下铁誓厅 }
  render_hint: "扳指自鸣要安静而确定，不写成大宗主降临。"
}

beat 不可夺王骨禁语压回夺权 @ structure.vol01.ch68 {
  effect:
    chars.姬断鹰.状态 = 被禁语压回
    chars.苏离灯.知道 += world.天驱护陵旧誓
    world.天驱宗主指套残模.状态 = 夺权失据

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.姬断鹰 }
  advances: { threads.天驱旧誓线, threads.大墓真相线 }
  mentions: { world.天驱护陵旧誓, world.天驱宗主指套残模, world.嬴无翳 }
  render_hint: "禁语压回夺权要明确旧誓保护的是不被夺用的王骨和真史。"
}

beat 姬断鹰旧誓失控 @ structure.vol01.ch68 {
  effect:
    chars.姬断鹰.状态 = 旧誓失控
    chars.姬断鹰.arc_state = 夺誓受挫
