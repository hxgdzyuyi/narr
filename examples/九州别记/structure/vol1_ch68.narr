  render_hint: "姬断鹰失控要来自他误解旧誓，而不是被简单击败。"
}

beat 守誓自定成形 @ structure.vol01.ch68 {
  effect:
    chars.苏离灯.状态 = 自定守誓
    chars.苏离灯.arc_state = 守誓自定
