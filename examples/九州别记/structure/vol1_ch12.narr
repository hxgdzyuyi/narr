namespace 九州别记.structure.vol1_ch12

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 星文风井露出 @ structure.vol01.ch12 {
  effect:
    chars.殷折.位置 = world.羽族坠羽井
    chars.苏离灯.位置 = world.羽族坠羽井
    chars.牧云镜.位置 = world.羽族坠羽井
    chars.硕风照夜.位置 = world.羽族坠羽井
    world.羽族坠羽井.状态 = 星文露出

  pov: chars.苏离灯
  location: world.羽族坠羽井
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜, chars.硕风照夜 }
  advances: { threads.误入地宫线, threads.大墓真相线 }
  mentions: { world.羽族坠羽井, world.星文回廊 }
  render_hint: "风井出现是空间继续打开，不是羽族主导建陵的证据。"
}

beat 牧云镜辨古航残片 @ structure.vol01.ch12 {
  effect:
    chars.牧云镜.状态 = 辨出古航残片
    chars.牧云镜.知道 += world.羽族坠羽井传闻
    chars.牧云镜.知道 += world.羽族星文传统
    world.羽族星文树皮卷.状态 = 星文展开

  pov: chars.牧云镜
  location: world.羽族坠羽井
  on_screen: true
  observers: { chars.牧云镜, chars.苏离灯, chars.殷折 }
  advances: { threads.封陵旧史线, threads.九州野史线 }
  reveals: world.羽族坠羽井传闻
  mentions: { world.羽族元极道, world.羽族星文树皮卷 }
  render_hint: "古航残片要解释材料和星文来源，不要直接推成墓主身份。"
}

beat 苏离灯护住断羽誓 @ structure.vol01.ch12 {
  effect:
    chars.苏离灯.状态 = 分辨星誓
    chars.苏离灯.知道 += world.天驱旧誓残痕
    chars.苏离灯.关系 += "把天驱旧誓与羽族星文分开辨认"
    world.旧鹰扳指.状态 = 裂纹微鸣

  pov: chars.苏离灯
  location: world.羽族坠羽井
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  mentions: { world.旧鹰扳指, world.天驱旧盟, world.羽族坠羽井 }
  render_hint: "苏离灯守住辨析边界，避免把所有星文都算到天驱或辰月。"
}

beat 闻人借星误导井文 @ structure.vol01.ch12 {
  effect:
    chars.闻人观星.位置 = world.辰月星坛
    chars.闻人观星.状态 = 借井文误导
    chars.闻人观星.知道 += world.羽族坠羽井传闻

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  mentions: { world.辰月星坛, world.羽族坠羽井, world.十二主星盘 }
  render_hint: "闻人借星文制造误读，仍然只是操纵证据解释。"
}

beat 硕风照夜听出北陆旧风 @ structure.vol01.ch12 {
  effect:
    chars.硕风照夜.状态 = 听出北陆旧风
    chars.硕风照夜.知道 += world.北陆草原与冰原
    chars.硕风照夜.知道 += world.瀚州八部入局
    world.羽族坠羽井.状态 = 星文显现

  pov: chars.硕风照夜
  location: world.羽族坠羽井
  on_screen: true
  observers: { chars.硕风照夜, chars.苏离灯, chars.殷折 }
  advances: { threads.瀚州草原线, threads.误入地宫线 }
  mentions: { world.瀚州, world.北陆狼道, world.羽族坠羽井 }
  render_hint: "用井风和旧歌把北陆线接入地下空间，而不是离题写地理说明。"
}
