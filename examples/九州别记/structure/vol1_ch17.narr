namespace 九州别记.structure.vol1_ch17

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 墓志夹层开匣 @ structure.vol01.ch17 {
  effect:
    chars.牧云镜.位置 = world.墓志石室
    chars.殷折.位置 = world.墓志石室
    chars.穆如砚.位置 = world.墓志石室
    chars.苏离灯.位置 = world.墓志石室
    world.墓志石室.状态 = 夹层开匣

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚, chars.苏离灯 }
  advances: { threads.误入地宫线, threads.封陵旧史线 }
  mentions: { world.墓志石室, world.殇阳关战牍 }
  render_hint: "夹层开匣要像证物浮出，不像宝库开启。"
}

beat 殇阳战牍半出 @ structure.vol01.ch17 {
  effect:
    chars.牧云镜.状态 = 读出殇阳战牍
    chars.牧云镜.知道 += world.殇阳关战役事实
    world.殇阳关战牍.状态 = 战牍出土

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.殇阳梦境线, threads.九州野史线, threads.大墓真相线 }
  reveals: world.殇阳关战役事实
  mentions: { world.殇阳关战牍, world.殇阳关, world.离国铁骑 }
  render_hint: "战牍先给战役事实，不在这里解决所有战史争议。"
}

beat 张博名位被污 @ structure.vol01.ch17 {
  effect:
    chars.牧云镜.状态 = 见名位被污
    chars.殷折.知道 += world.张博殇阳战死
    world.无名战牍残页.状态 = 张博名污

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.苏离灯 }
  sets_up: promises.张博归名伏笔
  advances: { threads.殇阳梦境线, threads.九州野史线 }
  reveals: world.张博殇阳战死
  mentions: { world.张博, world.无名战牍残页, world.殇阳关战牍 }
  render_hint: "张博的名字要显出又被污损，让归名成为明确任务。"
}

beat 牧云镜恐其动摇正史 @ structure.vol01.ch17 {
  effect:
    chars.牧云镜.状态 = 恐战牍动史
    chars.牧云镜.相信 += "殇阳关战牍会动摇端朝对前朝旧史的裁剪"
    chars.穆如砚.关系 += "守住牧云镜不让掩史司夺牍"

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.穆如砚, chars.殷折 }
  advances: { threads.端朝皇权线, threads.穆如军门线, threads.封陵旧史线 }
  mentions: { world.端朝, world.掩史司密库, world.殇阳关战牍 }
  render_hint: "正史危机要压到牧云镜身上，形成她继续护证的理由。"
}

beat 闻人催动残简 @ structure.vol01.ch17 {
  effect:
    chars.闻人观星.状态 = 催动残简战牍
    world.雷碧城星术残简.状态 = 牵动战牍
    world.殇阳关战牍.状态 = 与星术相连

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  advances: { threads.辰月暗流线, threads.殇阳梦境线, threads.大墓真相线 }
  mentions: { world.雷碧城星术残简, world.殇阳关战牍, world.十二主星盘 }
  render_hint: "闻人催动的是残简与战牍的污染关系，不是直接制造梦境胜负。"
}
