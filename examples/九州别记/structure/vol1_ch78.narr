beat 洛衡归扣留脉 @ structure.vol01.ch78 {
  effect:
    chars.洛衡.状态 = 归扣留脉
    world.河络地火锥.状态 = 定住封门
    world.河络地火机坊.状态 = 封门承重

  pov: chars.洛衡
