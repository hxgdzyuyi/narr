namespace 九州别记.structure.vol1_ch01

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 旧道封门受托 @ structure.vol01.ch01 {
  effect:
    world.无名旧道.状态 = 旧患初现
    chars.殷照胆.位置 = world.无名旧道
    chars.殷照胆.状态 = 受托封门
    chars.殷照胆.知道 += world.殷照胆封门旧事

  pov: chars.殷照胆
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷照胆 }
  sets_up: promises.祖辈封门伏笔
  advances: { threads.误入地宫线, threads.摸金门规线 }
  reveals: world.殷照胆封门旧事
  render_hint: "把封门活写成完整小故事的开端，是救人和守规矩，不是寻宝。"
}

beat 祖辈辨出活土 @ structure.vol01.ch01 {
  effect:
    world.殷门罗盘.状态 = 指向旧患
    chars.殷照胆.状态 = 辨出活土
    chars.殷照胆.知道 += world.殷氏罗盘旧训

  pov: chars.殷照胆
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷照胆 }
  sets_up: promises.殷门罗盘伏笔
  advances: threads.摸金门规线
  reveals: world.殷氏罗盘旧训
  mentions: { world.殷门罗盘, world.无名旧道 }
}

beat 门规救下后辈 @ structure.vol01.ch01 {
  effect:
    chars.殷照胆.关系 += "以门规救下殷门后辈"
    chars.殷照胆.知道 += world.殷门祖辈传承

  pov: chars.殷照胆
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷照胆 }
  advances: threads.摸金门规线
  reveals: world.殷门祖辈传承
  render_hint: "用一场封绳、分火、断后的小动作写清殷门门规。"
}

beat 石构吞人 @ structure.vol01.ch01 {
  effect:
    world.疑似封陵.状态 = 旧患封存
    chars.殷照胆.状态 = 被困旧道
    chars.殷照胆.相信 += "旧道下方不是寻常墓穴"

  pov: chars.殷照胆
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷照胆 }
  advances: { threads.大墓真相线, threads.九州野史线 }
  mentions: { world.疑似封陵, world.无名旧道 }
  render_hint: "只写见到石构和塌口吞人，不写墓主、不写王陵名号。"
}

beat 罗盘遗言归殷门 @ structure.vol01.ch01 {
  effect:
    chars.殷照胆.状态 = 殉门
    chars.殷照胆.arc_state = 以死封门
    chars.殷折.位置 = world.殷门旧宅
    chars.殷折.状态 = 继承遗物
    chars.殷折.知道 += world.殷照胆殉门事实
    chars.殷折.知道 += world.殷门祖辈传承
    world.殷门罗盘.状态 = 传给殷折

  pov: chars.殷折
  location: world.殷门旧宅
  on_screen: true
  observers: { chars.殷折 }
  pays_off: promises.祖辈封门伏笔
  advances: { threads.摸金门规线, threads.九州野史线 }
  reveals: world.殷照胆殉门事实
  render_hint: "祖辈死亡是第一章收束，遗物启动后辈故事。"
}
