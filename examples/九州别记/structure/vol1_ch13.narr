    world.鲛泪暗渠.状态 = 潮路显证

  pov: chars.牧云镜
  location: world.鲛泪暗渠
  on_screen: true
  observers: { chars.牧云镜, chars.殷折 }
  advances: { threads.封陵旧史线, threads.九州野史线 }
  reveals: world.鲛泪暗渠事实
  mentions: { world.鲛族, world.鲛绡残丝, world.鲛泪暗渠 }
  render_hint: "鲛绡残丝证明材料流通，不把鲛族写成墓葬主人。"
}

beat 牧云烬截取盐珠 @ structure.vol01.ch13 {
  effect:
    chars.牧云烬.位置 = world.鲛泪暗渠
