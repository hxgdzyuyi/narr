  observers: { chars.牧云烬, chars.殷折, chars.牧云镜, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.穆如军门线 }
  mentions: { world.鲛泪盐珠, world.端朝掩史司 }
  render_hint: "盐珠争夺要服务证物控制，不写成财宝争夺。"
}

beat 殷折拒取殉珠 @ structure.vol01.ch13 {
  effect:
    chars.殷折.状态 = 拒取殉珠
    chars.殷折.关系 += "按门规拒绝把殉珠当财物带走"
