beat 盐线引入暗渠 @ structure.vol01.ch13 {
  effect:
    chars.殷折.位置 = world.鲛泪暗渠
    chars.牧云镜.位置 = world.鲛泪暗渠
    chars.穆如砚.位置 = world.鲛泪暗渠
    chars.苏离灯.位置 = world.鲛泪暗渠
    world.鲛泪暗渠.状态 = 盐线显露

  pov: chars.牧云镜
  location: world.鲛泪暗渠
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚, chars.苏离灯 }
  advances: { threads.误入地宫线, threads.大墓真相线 }
  mentions: { world.鲛泪暗渠, world.羽族坠羽井 }
  render_hint: "盐线从风井接到暗渠，写空间连通，不写成寻宝暗道。"
}

beat 鲛绡残丝证水路 @ structure.vol01.ch13 {
  effect:
    chars.牧云镜.状态 = 记录潮路证据
