  pov: chars.牧云镜
  location: world.星文回廊
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.大墓真相线, threads.九州野史线 }
  mentions: { world.离公墓志残片, world.殇阳关战牍, world.殇阳梦境残印 }
  render_hint: "三证同壁要像证词被迫并置，不是最终审判。"
}

beat 闻人改写霸主旧史 @ structure.vol01.ch65 {
  effect:
    chars.闻人观星.状态 = 改写霸主旧史
