beat 断简补上重封年代 @ structure.vol01.ch47 {
  effect:
    chars.穆如砚.位置 = world.封陵外城
    chars.穆如砚.状态 = 校出重封年代
    world.封陵外城.状态 = 重封年代归位

  pov: chars.穆如砚
  location: world.封陵外城
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.洛衡 }
  advances: { threads.封陵旧史线, threads.穆如军门线 }
  reveals: world.燮朝封陵残证
  mentions: { world.燮朝封陵残证, world.封陵外城, world.燮朝 }
  render_hint: "补上的年代只证明重封层，不要让它抢先说明完整墓主。"
}

