  pov: chars.穆如砚
  location: world.墓志石室
  on_screen: true
  observers: { chars.穆如砚, chars.牧云烬, chars.牧云镜, chars.殷折 }
  advances: { threads.穆如军门线, threads.端朝皇权线, threads.大墓真相线 }
  mentions: { world.穆如军门, world.端末盟约破裂, world.穆如旧令抄本 }
  render_hint: "穆如砚护的是证据和活人，不是抢先掌握墓主名。"
}

beat 苏离灯警觉旧誓失衡 @ structure.vol01.ch46 {
  effect:
    chars.苏离灯.位置 = world.墓志石室
    chars.苏离灯.状态 = 警觉旧誓失衡
