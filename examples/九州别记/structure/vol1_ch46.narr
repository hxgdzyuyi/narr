  mentions: { world.旧鹰扳指, world.天驱护陵旧誓, world.天驱旧盟 }
  render_hint: "旧誓失衡说明墓主确认会牵动王道盟约，不让政治线孤立。"
}

beat 闻人借正统裂缝 @ structure.vol01.ch46 {
  effect:
    chars.闻人观星.状态 = 借正统裂缝
    world.辰月暗宗.状态 = 借正统裂缝
    world.十二主星盘.状态 = 推演正统裂缝

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  advances: { threads.辰月暗流线, threads.端朝皇权线, threads.大墓真相线 }
