beat 牧云镜试写不上名 @ structure.vol01.ch46 {
  effect:
    chars.牧云镜.位置 = world.墓志石室
    chars.牧云镜.状态 = 不敢上呈墓主名
    chars.牧云镜.相信 += "离公墓门之证不能写成献捷章"

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.九州野史线 }
  mentions: { world.端朝, world.牧云掩史旧档, world.嬴无翳未帝而霸 }
  render_hint: "牧云镜写不下名字，是因为她知道一旦上呈，证据会被皇权夺用。"
}

beat 牧云烬索牍封口 @ structure.vol01.ch46 {
  effect:
    chars.牧云烬.位置 = world.墓志石室
    chars.牧云烬.状态 = 索牍封口
    world.殇阳关战牍.状态 = 被索封口

  pov: chars.牧云烬
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云烬, chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.封陵旧史线 }
  mentions: { world.殇阳关战牍, world.端朝掩史司, world.掩史司密库 }
  render_hint: "牧云烬要把证据变成封口材料，推动正统压力而不是普通夺宝冲突。"
}

beat 穆如砚护证违诏加深 @ structure.vol01.ch46 {
  effect:
    chars.穆如砚.状态 = 违诏护证加深
    chars.穆如砚.关系 += "与牧云烬正面冲突"
