namespace 九州别记.structure.vol1_ch42

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 战牍军目重读 @ structure.vol01.ch42 {
  effect:
    chars.牧云镜.位置 = world.墓志石室
    chars.牧云镜.状态 = 重读战牍军目
    world.殇阳关战牍.状态 = 军目重读

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.殇阳梦境线, threads.九州野史线 }
  mentions: { world.殇阳关战牍, world.殇阳关战役事实, world.离国铁骑 }
  render_hint: "重读战牍时强调军目和调度，不把它写成藏宝图。"
}

beat 赤旅番号相合 @ structure.vol01.ch42 {
  effect:
    world.离国马具残饰.状态 = 赤旅军制坐实
    world.离国赤旅.状态 = 军制坐实
    world.离国铁骑.状态 = 军制成链

  pov: chars.穆如砚
  location: world.墓志石室
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.洛衡 }
  advances: { threads.大墓真相线, threads.穆如军门线 }
  mentions: { world.离国马具残饰, world.离国赤旅, world.赤旅兵冢 }
  render_hint: "番号相合要像军门校验，不像猜谜碰运气。"
}

beat 牧云镜读出军政调度 @ structure.vol01.ch42 {
  effect:
    chars.牧云镜.知道 += world.嬴无翳用人与军政
    chars.牧云镜.状态 = 读出离国军政调度
    world.殇阳关战牍.状态 = 军制互证

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.九州野史线, threads.大墓真相线, threads.端朝皇权线 }
  reveals: world.嬴无翳用人与军政
  mentions: { world.嬴无翳用人与军政, world.殇阳关战牍, world.端朝 }
  render_hint: "军政调度让危险扩大到正史，不是让牧云镜兴奋发现名人遗物。"
}

beat 殷折拒作寻宝证 @ structure.vol01.ch42 {
  effect:
    chars.殷折.状态 = 拒作寻宝证
    chars.殷折.相信 += "证物越像宝，越要先按门规保活人"
    world.霸刀断铭.状态 = 与战牍互照

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.洛衡 }
  advances: { threads.摸金门规线, threads.大墓真相线 }
  mentions: { world.霸刀断铭, world.殷门罗盘, world.摸金殷门 }
  render_hint: "殷折的选择要压住夺宝冲动，让门规成为确认过程的一部分。"
}

beat 战牍牵回墓志残片 @ structure.vol01.ch42 {
  effect:
    world.离公墓志残片.状态 = 待合军制
    world.殇阳关战牍.状态 = 军制互证
    chars.殷折.位置 = world.墓志石室

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.封陵旧史线, threads.殇阳梦境线, threads.大墓真相线 }
  mentions: { world.离公墓志残片, world.殇阳关战牍, world.墓志石室 }
  render_hint: "章末把战牍和墓志残片重新扣合，为缺名章节做入口。"
}
