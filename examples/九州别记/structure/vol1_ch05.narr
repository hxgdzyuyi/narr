namespace 九州别记.structure.vol1_ch05

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 外城甬道验风 @ structure.vol01.ch05 {
  effect:
    chars.殷折.位置 = world.封陵外城
    chars.洛衡.位置 = world.封陵外城
    chars.牧云镜.位置 = world.封陵外城
    chars.穆如砚.位置 = world.封陵外城
    chars.殷折.状态 = 验风分火
    chars.洛衡.状态 = 校准机关术

  pov: chars.殷折
  location: world.封陵外城
  on_screen: true
  observers: { chars.殷折, chars.洛衡, chars.牧云镜, chars.穆如砚 }
  advances: { threads.误入地宫线, threads.摸金门规线 }
  mentions: { world.封陵外城, world.疑似封陵 }
  render_hint: "先用分火、验风和绳距写外城规模，保持探索的慢节奏。"
}

beat 牧云镜辨出燮年错铭 @ structure.vol01.ch05 {
  effect:
    chars.牧云镜.状态 = 辨出错铭
    chars.牧云镜.知道 += world.燮朝封陵残证
    chars.牧云镜.知道 += world.牧云掩史旧档
    world.封陵外城.状态 = 错铭显现

  pov: chars.牧云镜
  location: world.封陵外城
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  advances: { threads.封陵旧史线, threads.端朝皇权线, threads.九州野史线 }
  reveals: world.燮朝封陵残证
  mentions: { world.燮朝, world.封陵外城 }
  render_hint: "错铭说明燮朝重封，删掉的名字比出现的年号更重要。"
}

beat 穆如砚对照旧令 @ structure.vol01.ch05 {
  effect:
    chars.穆如砚.状态 = 对照军令
    chars.穆如砚.知道 += world.燮朝封陵残证
    chars.穆如砚.知道 += world.穆如封陵军令抄本
    world.穆如旧令抄本.状态 = 对上门制

  pov: chars.穆如砚
  location: world.封陵外城
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.殷折 }
  advances: { threads.穆如军门线, threads.封陵旧史线 }
  mentions: { world.穆如军门, world.穆如旧令抄本, world.封陵外城 }
  render_hint: "穆如旧令只证明有人奉命封道，不给墓主答案。"
}

beat 洛衡证实二次改封 @ structure.vol01.ch05 {
  effect:
    chars.洛衡.状态 = 证实改封
    chars.洛衡.知道 += world.燮朝封陵残证
    chars.洛衡.相信 += "外城机关被后世重铺过一层"
    world.封陵外城.状态 = 断简显证

  pov: chars.洛衡
  location: world.封陵外城
  on_screen: true
  observers: { chars.洛衡, chars.殷折, chars.牧云镜 }
  advances: { threads.大墓真相线, threads.封陵旧史线 }
  mentions: { world.河络机关残页, world.封陵外城 }
  render_hint: "二次改封要靠机关层和断简位置来说明。"
}

beat 闻人借星传局 @ structure.vol01.ch05 {
  effect:
    chars.闻人观星.位置 = world.辰月星坛
    chars.闻人观星.状态 = 借错铭布疑
    chars.闻人观星.知道 += world.燮朝封陵残证

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  sets_up: promises.辰月远观悬念
  advances: threads.辰月暗流线
  mentions: { world.辰月星坛, world.辰月暗宗, world.燮朝 }
  render_hint: "辰月拿到的是可利用的旧史线索，不是确定的墓主姓名。"
}
