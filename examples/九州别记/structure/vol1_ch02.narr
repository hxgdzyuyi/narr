namespace 九州别记.structure.vol1_ch02

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 殷折启封罗盘 @ structure.vol01.ch02 {
  effect:
    chars.殷折.位置 = world.殷门旧宅
    chars.殷折.状态 = 掌握寻龙初法
    chars.殷折.知道 += world.摸金技艺来源
    chars.殷折.知道 += world.殷氏罗盘旧训
    world.殷门罗盘.状态 = 可用

  pov: chars.殷折
  location: world.殷门旧宅
  on_screen: true
  observers: { chars.殷折 }
  pays_off: promises.殷门罗盘伏笔
  advances: threads.摸金门规线
  reveals: { world.摸金技艺来源, world.殷氏罗盘旧训 }
}

beat 洛衡拆解旧锁 @ structure.vol01.ch02 {
  effect:
    chars.洛衡.位置 = world.殷门旧宅
    chars.洛衡.状态 = 校准机关术
    chars.洛衡.知道 += world.洛氏机关残学
    world.河络机关残页.状态 = 校读

  pov: chars.洛衡
  location: world.殷门旧宅
  on_screen: true
  observers: { chars.洛衡, chars.殷折 }
  sets_up: promises.机关残学伏笔
  advances: { threads.摸金门规线, threads.大墓真相线 }
  reveals: world.洛氏机关残学
  render_hint: "机关术是拆锁、看承重、避死门，不要写成神乎其神的开挂能力。"
}

beat 硕风听雪辨空 @ structure.vol01.ch02 {
  effect:
    chars.硕风照夜.位置 = world.殷门旧宅
    chars.硕风照夜.状态 = 辨得地声
    chars.硕风照夜.知道 += world.硕风吞狼旧歌
    chars.硕风照夜.知道 += world.雪下空音事实

  pov: chars.硕风照夜
  location: world.殷门旧宅
  on_screen: true
  observers: { chars.硕风照夜, chars.殷折 }
  sets_up: promises.草原旧歌伏笔
  advances: { threads.瀚州草原线, threads.误入地宫线 }
  reveals: { world.硕风吞狼旧歌, world.雪下空音事实 }
}

beat 苏离灯试鹰扳指 @ structure.vol01.ch02 {
  effect:
    chars.苏离灯.位置 = world.殷门旧宅
    chars.苏离灯.状态 = 隐名试戒
    chars.苏离灯.arc_state = 守誓而疑誓
    chars.苏离灯.知道 += world.天驱护陵旧誓
    world.旧鹰扳指.状态 = 微热未明

  pov: chars.苏离灯
  location: world.殷门旧宅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  sets_up: promises.天驱扳指伏笔
  advances: threads.天驱旧誓线
  reveals: world.天驱护陵旧誓
  mentions: { world.天驱旧盟, world.旧鹰扳指 }
}

beat 牧云穆如携旧档入局 @ structure.vol01.ch02 {
  effect:
    chars.牧云镜.位置 = world.殷门旧宅
    chars.穆如砚.位置 = world.殷门旧宅
    chars.牧云镜.状态 = 持诏入局
    chars.穆如砚.状态 = 军令封道
    chars.牧云镜.知道 += world.牧云掩史旧档
    chars.穆如砚.知道 += world.穆如封陵军令抄本
    world.穆如旧令抄本.状态 = 展开

  pov: chars.牧云镜
  location: world.殷门旧宅
  on_screen: true
  observers: { chars.牧云镜, chars.穆如砚, chars.殷折 }
  sets_up: { promises.军门密诏悬念, promises.燮朝重封伏笔 }
  advances: { threads.端朝皇权线, threads.穆如军门线, threads.封陵旧史线 }
  reveals: { world.牧云掩史旧档, world.穆如封陵军令抄本 }
  mentions: { world.端朝, world.穆如军门, world.燮朝 }
}
