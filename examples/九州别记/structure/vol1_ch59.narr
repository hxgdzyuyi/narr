beat 雪驿夜诏封营 @ structure.vol01.ch59 {
  effect:
    chars.穆如砚.位置 = world.雪炽原旧驿
    chars.穆如砚.状态 = 夜诏封营
    world.端朝掩史司.状态 = 夜诏封营

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜 }
  advances: { threads.穆如军门线, threads.端朝皇权线 }
  mentions: { world.雪炽原旧驿, world.端朝掩史司, world.穆如军门 }
  render_hint: "夜诏压到旧驿，制造必须立刻选择的外部压力。"
}

beat 牧云烬下灭证令 @ structure.vol01.ch59 {
  effect:
    chars.牧云烬.状态 = 下灭证令
    world.端朝掩史司.状态 = 灭证令出
    world.端朝.状态 = 灭证压境

  pov: chars.牧云烬
  location: world.掩史司密库
  on_screen: true
  observers: { chars.牧云烬 }
  advances: { threads.端朝皇权线, threads.九州野史线 }
  mentions: { world.端朝掩史司, world.掩史司密库, world.牧云掩史旧档 }
  render_hint: "灭证令要是政治命令，不写成牧云烬个人失控。"
}

beat 穆如砚护民拔营 @ structure.vol01.ch59 {
  effect:
    chars.穆如砚.状态 = 护民拔营
    chars.穆如砚.关系 += "带军户和边民离开封口营"
    world.穆如军门.状态 = 拔营护民

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.硕风照夜 }
  advances: { threads.穆如军门线, threads.瀚州草原线 }
  mentions: { world.穆如军门, world.雪炽原, world.殇州流放道 }
  render_hint: "拔营是违诏前的实质行动，兼顾军门和边民。"
}

beat 牧云镜抗诏署名 @ structure.vol01.ch59 {
  effect:
    chars.牧云镜.状态 = 抗诏署名
    chars.牧云镜.arc_state = 署名抗诏
    world.殇阳关战牍.状态 = 署名副录

  pov: chars.牧云镜
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云镜, chars.穆如砚, chars.殷折 }
  advances: { threads.九州野史线, threads.端朝皇权线, threads.穆如军门线 }
  mentions: { world.牧云掩史旧档, world.离公墓志残片, world.端末盟约破裂 }
  render_hint: "署名让牧云镜从暗中留史走到公开承担。"
}

beat 闻人观星等裂口 @ structure.vol01.ch59 {
  effect:
    chars.闻人观星.状态 = 等裂口开阵
    world.十二主星盘.状态 = 裂口待启
    world.辰月暗宗.状态 = 借裂候阵

