import 九州别记.structure.vol1_ch36 as vol1_ch36
import 九州别记.structure.vol1_ch37 as vol1_ch37
import 九州别记.structure.vol1_ch38 as vol1_ch38
import 九州别记.structure.vol1_ch39 as vol1_ch39
