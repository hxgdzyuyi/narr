import 九州别记.structure.vol1_ch75 as vol1_ch75
import 九州别记.structure.vol1_ch76 as vol1_ch76
import 九州别记.structure.vol1_ch77 as vol1_ch77
import 九州别记.structure.vol1_ch78 as vol1_ch78
import 九州别记.structure.vol1_ch79 as vol1_ch79
