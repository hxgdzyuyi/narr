namespace 九州别记.structure.vol1_ch23

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 国师府影入牍 @ structure.vol01.ch23 {
  effect:
    world.雷碧城.状态 = 梦中国师星局显形
    world.离国国师府.状态 = 梦中显影
    chars.殷折.知道 += world.离国辰月牵连

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.辰月暗流线, threads.九州野史线 }
  reveals: { world.雷碧城辰月国师, world.离国辰月牵连 }
  mentions: { world.雷碧城, world.离国国师府, world.离国辰月牵连 }
  render_hint: "国师府影子要服务污染来源，不要变成梦中政务戏。"
}

beat 十二主星误写军册 @ structure.vol01.ch23 {
  effect:
    world.十二主星盘.状态 = 误写军册
    world.殇阳关战牍.状态 = 星文误写
    chars.殷折.知道 += world.十二主星秘术体系

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  reveals: world.十二主星秘术体系
  mentions: { world.十二主星盘, world.殇阳关战牍, world.十二主星秘术体系 }
  render_hint: "星盘误写要表现为战牍被套入星命逻辑，而不是战牍失去物证价值。"
}

beat 闻人借污读名 @ structure.vol01.ch23 {
  effect:
    chars.闻人观星.位置 = world.辰月星坛
    chars.闻人观星.状态 = 借污读名
    world.十二主星盘.状态 = 借污读名

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  observers: { chars.闻人观星 }
  advances: { threads.辰月暗流线, threads.端朝皇权线 }
  mentions: { world.辰月星坛, world.十二主星盘, world.无名战牍残页 }
  render_hint: "闻人只能借旧污染偷读方向，不能隔空掌握完整群名。"
}

beat 殷折守住证据链 @ structure.vol01.ch23 {
  effect:
    chars.殷折.状态 = 守住战牍证据
    chars.殷折.相信 += "星术只能污染证据，不能替代证据"
    world.殇阳关战牍.状态 = 证据链未断

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.摸金门规线, threads.大墓真相线, threads.九州野史线 }
  mentions: { world.殇阳关战牍, world.星文观测原则, world.雷碧城星术残简 }
  render_hint: "殷折的选择是回到证据和姓名，而不是与术士比拼术法。"
}

beat 残页留下反污路 @ structure.vol01.ch23 {
  effect:
    world.无名战牍残页.状态 = 反污可循
    world.雷碧城星术残简.状态 = 污痕可辨
    chars.殷折.状态 = 找到反污路

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.辰月暗流线, threads.摸金门规线 }
  reveals: world.星文观测原则
  mentions: { world.无名战牍残页, world.雷碧城星术残简, world.星文观测原则 }
  render_hint: "反污路只能让殷折继续追名，不让他立刻清除全部污染。"
}
