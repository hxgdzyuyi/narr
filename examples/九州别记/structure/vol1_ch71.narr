namespace 九州别记.structure.vol1_ch71

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 星盘反噬裂回廊 @ structure.vol01.ch71 {
  effect:
    world.十二主星盘.状态 = 星局反噬
    world.雷碧城星术残简.状态 = 星局断线
    chars.闻人观星.状态 = 星局受挫

  pov: chars.殷折
  location: world.星文回廊
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜 }
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  reveals: world.秘术溢出风险
  mentions: { world.十二主星盘, world.雷碧城星术残简, world.星文观测原则 }
  render_hint: "星盘反噬要写成辰月推演过载后的崩裂，不写成主角凭空取胜。"
}

beat 掩史司逼夺残证 @ structure.vol01.ch71 {
  effect:
    chars.牧云烬.位置 = world.墓志石室
    chars.牧云烬.状态 = 夺证封口
    world.端朝掩史司.状态 = 奉诏夺证

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.牧云烬, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.九州野史线 }
  mentions: { world.端朝掩史司, world.牧云掩史旧档, world.离公墓志残片 }
  render_hint: "牧云烬的动作要体现皇权夺证压力，而不是单纯抢宝。"
}

beat 三证摊开待择 @ structure.vol01.ch71 {
  effect:
    chars.牧云镜.状态 = 摊证待择
    world.殇阳关战牍.状态 = 与墓志互证
    world.离公墓志残片.状态 = 三证待择

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.九州野史线, threads.大墓真相线 }
  mentions: { world.离公墓志残片, world.殇阳关战牍, world.雷碧城星术残简 }
  render_hint: "三证要形成选择压力，不能让任何单证独自宣布答案。"
}

beat 殷折定下四难 @ structure.vol01.ch71 {
  effect:
    chars.殷折.位置 = world.墓志石室
    chars.殷折.状态 = 四难当前
    chars.殷折.arc_state = 守门择史

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜, chars.穆如砚 }
  advances: { threads.摸金门规线, threads.误入地宫线, threads.九州野史线 }
  mentions: { world.殷门祖辈传承, world.嬴无翳墓葬危险原则, world.疑似封陵 }
  render_hint: "四难分别是封存、留史、护民、出地，殷折要先承认无法全取。"
}

beat 塌声催向地面 @ structure.vol01.ch71 {
  effect:
    world.无名旧道.状态 = 回塌将合
    world.疑似封陵.状态 = 封门倒计
    chars.殷折.知道 += world.嬴无翳墓葬危险原则

  pov: chars.殷折
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷折, chars.洛衡, chars.硕风照夜 }
  advances: { threads.误入地宫线, threads.大墓真相线 }
  mentions: { world.无名旧道, world.疑似封陵, world.边地塌陷事实 }
  render_hint: "章末用塌声把讨论推向行动，提醒众人还有活人要救。"
}
