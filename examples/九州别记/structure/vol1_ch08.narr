namespace 九州别记.structure.vol1_ch08

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 丁缺金诱入兵冢岔路 @ structure.vol01.ch08 {
  effect:
    chars.丁缺金.位置 = world.封陵外城
    chars.丁缺金.状态 = 引队入歧
    chars.殷折.位置 = world.封陵外城
    chars.洛衡.位置 = world.封陵外城
    chars.丁缺金.关系 += "借岔路误导殷折"

  pov: chars.丁缺金
  location: world.封陵外城
  on_screen: true
  observers: { chars.丁缺金, chars.殷折, chars.洛衡 }
  advances: { threads.摸金门规线, threads.辰月暗流线 }
  mentions: { world.封陵外城, world.赤旅兵冢 }
  render_hint: "诱路要像熟悉门规的人在钻空子，而不是突然暴露。"
}

beat 赤旅铜钉显出军工 @ structure.vol01.ch08 {
  effect:
    chars.殷折.位置 = world.赤旅兵冢
    chars.洛衡.位置 = world.赤旅兵冢
    chars.丁缺金.位置 = world.赤旅兵冢
    chars.洛衡.知道 += world.离国军工痕迹
    chars.丁缺金.知道 += world.离国军工痕迹
    world.赤旅兵冢.状态 = 军工待辨

  pov: chars.洛衡
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.洛衡, chars.殷折, chars.丁缺金 }
  advances: { threads.大墓真相线, threads.九州野史线 }
  reveals: world.离国军工痕迹
  mentions: { world.赤旅兵冢, world.离国赤旅, world.疑似离公墓域 }
  render_hint: "铜钉和铸痕只能说明离国军工痕迹，不要确认墓主。"
}

beat 丁缺金夺灯现形 @ structure.vol01.ch08 {
  effect:
    chars.丁缺金.状态 = 露出背门
    chars.丁缺金.arc_state = 贪生背门
    chars.殷折.关系 += "确认丁缺金背门"

  pov: chars.丁缺金
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.丁缺金, chars.殷折, chars.洛衡 }
  pays_off: promises.丁缺金背叛伏笔
  advances: { threads.摸金门规线, threads.误入地宫线 }
  mentions: { world.赤旅兵冢, world.殷门罗盘 }
  render_hint: "背叛是抢灯和断路，不是长篇自白。"
}

beat 辰月暗号浮上铜皮 @ structure.vol01.ch08 {
  effect:
    chars.闻人观星.状态 = 借暗号收网
    chars.闻人观星.知道 += world.离国军工痕迹
    chars.丁缺金.关系 += "受辰月暗号牵引"

  pov: chars.闻人观星
  location: world.辰月星坛
  on_screen: true
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  mentions: { world.辰月暗宗, world.赤旅兵冢, world.离国赤旅 }
  render_hint: "辰月暗号让背叛和地宫线相接，但闻人仍不需要确认墓主。"
}

beat 殷折守规救回叛徒 @ structure.vol01.ch08 {
  effect:
    chars.殷折.状态 = 守规救人
    chars.殷折.arc_state = 守规担责
    chars.丁缺金.状态 = 露出背门
    chars.丁缺金.位置 = world.赤旅兵冢
    chars.殷折.关系 += "按门规救回丁缺金"
    world.赤旅兵冢.状态 = 军工待辨

  pov: chars.殷折
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.殷折, chars.丁缺金, chars.洛衡 }
  advances: { threads.摸金门规线, threads.误入地宫线, threads.大墓真相线 }
  mentions: { world.赤旅兵冢, world.摸金殷门 }
  render_hint: "殷折救人不是原谅背叛，而是选择不让门规在自己手里断掉。"
}
