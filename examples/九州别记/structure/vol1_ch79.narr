import 九州别记.threads as threads
import 九州别记.promises as promises

beat 地宫末路让生 @ structure.vol01.ch79 {
  effect:
    chars.殷折.位置 = world.无名旧道
    chars.殷折.状态 = 领队出地
    world.疑似离公墓域.状态 = 封门之后

  pov: chars.殷折
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.洛衡 }
  advances: { threads.误入地宫线, threads.摸金门规线 }
  mentions: { world.无名旧道, world.疑似离公墓域, world.疑似封陵 }
  render_hint: "撤离要带出封门后的空旷和压迫，不写成凯旋取宝。"
}

beat 丁缺金守最后岔口 @ structure.vol01.ch79 {
  effect:
    chars.丁缺金.位置 = world.无名旧道
    chars.丁缺金.状态 = 背门封岔
    chars.丁缺金.arc_state = 背门归账

  pov: chars.殷折
  location: world.无名旧道
  on_screen: true
  observers: { chars.殷折, chars.丁缺金 }
  resolves: threads.摸金门规线
  advances: threads.误入地宫线
  mentions: { world.丁缺金门规旧债, world.摸金殷门, world.无名旧道 }
  render_hint: "丁缺金守岔口是背叛的最终归处，让门规完成记账。"
}

beat 牧云烬空诏失证 @ structure.vol01.ch79 {
  effect:
    chars.牧云烬.状态 = 空诏失证
    world.端朝掩史司.状态 = 未能独占
    world.端朝.状态 = 末世分裂

  pov: chars.牧云镜
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云镜, chars.牧云烬, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.九州野史线 }
  mentions: { world.端朝掩史司, world.端朝, world.牧云掩史旧档 }
  render_hint: "牧云烬失去的是独占证据的权力，不是端朝线的全部后果。"
}

beat 牧云镜护残史上行 @ structure.vol01.ch79 {
  effect:
    chars.牧云镜.位置 = world.雪炽原旧驿
    chars.牧云镜.状态 = 护史上行
    world.离公墓志残片.状态 = 留史不夺

  pov: chars.牧云镜
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云镜, chars.殷折 }
  advances: { threads.九州野史线, threads.大墓真相线 }
  mentions: { world.离公墓志残片, world.九州别记朝代用法, world.雪炽原旧驿 }
  render_hint: "牧云镜护的是可追残史，不是替牧云氏抢回密档。"
}

beat 主角团出地不夺 @ structure.vol01.ch79 {
  effect:
    chars.殷折.位置 = world.雪炽原旧驿
    chars.殷折.状态 = 带证出地
    world.无名旧道.状态 = 重封归静

  pov: chars.殷折
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜, chars.穆如砚 }
  advances: { threads.误入地宫线, threads.九州野史线, threads.大墓真相线 }
  mentions: { world.无名旧道, world.疑似封陵, world.离公墓志残片 }
  render_hint: "章末要让出地和不夺同时成立，为终章雪驿别记留出静场。"
}
