namespace 九州别记.structure.vol1_ch52

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 密库收讯立案 @ structure.vol01.ch52 {
  effect:
    chars.牧云烬.位置 = world.掩史司密库
    chars.牧云烬.状态 = 密库立案
    world.端朝掩史司.状态 = 墓证立案

  pov: chars.牧云烬
  location: world.掩史司密库
  on_screen: true
  observers: { chars.牧云烬 }
  advances: { threads.端朝皇权线, threads.封陵旧史线 }
  mentions: { world.掩史司密库, world.端朝掩史司, world.嬴无翳 }
  render_hint: "密库立案要写成文书和证物进入权力程序。"
}

beat 牧云烬拟皇权证词 @ structure.vol01.ch52 {
  effect:
    chars.牧云烬.状态 = 拟皇权证词
    chars.牧云烬.知道 += world.中州天启中心性
    world.端室牧云氏.状态 = 借墓稳权

  pov: chars.牧云烬
  location: world.掩史司密库
  on_screen: true
  observers: { chars.牧云烬 }
  advances: { threads.端朝皇权线, threads.九州野史线 }
  reveals: world.中州天启中心性
  mentions: { world.端室牧云氏, world.天启城, world.嬴无翳未帝而霸 }
  render_hint: "证词把霸主旧史转译成端朝皇权材料，显示牧云烬的政治判断。"
}

beat 掩史司列封口册 @ structure.vol01.ch52 {
  effect:
    chars.牧云烬.状态 = 列封口册
    world.端朝掩史司.状态 = 封口列名
    chars.牧云镜.状态 = 被列入封口
    chars.穆如砚.状态 = 被列入封口

  pov: chars.牧云烬
  location: world.掩史司密库
  on_screen: true
  observers: { chars.牧云烬 }
  advances: { threads.端朝皇权线, threads.穆如军门线 }
  mentions: { world.端朝掩史司, chars.牧云镜, chars.穆如砚 }
  render_hint: "封口册要同时威胁史官、军门和摸金队。"
}

beat 端室牧云索取墓证 @ structure.vol01.ch52 {
  effect:
    world.端朝.状态 = 皇权索证
    world.端室牧云氏.状态 = 索取墓证
    chars.牧云烬.相信 += "墓主真相若不能献给皇权，就只能作为乱史证据封死"

  pov: chars.牧云烬
  location: world.天启城
  on_screen: true
  observers: { chars.牧云烬 }
  advances: { threads.端朝皇权线, threads.大墓真相线 }
  mentions: { world.端朝, world.端室牧云氏, world.掩史司密库 }
  render_hint: "端室索证是权力压力，不要写成公开朝会大白天下。"
}

beat 金匣反压旧驿 @ structure.vol01.ch52 {
  effect:
    chars.牧云烬.状态 = 金匣压驿
    world.端朝掩史司.状态 = 皇权取证
    world.殇阳关战牍.状态 = 封口令至

  pov: chars.牧云烬
  location: world.掩史司密库
  on_screen: true
  observers: { chars.牧云烬 }
  advances: { threads.端朝皇权线, threads.穆如军门线 }
  mentions: { world.雪炽原旧驿, world.端朝掩史司, world.穆如军门 }
  render_hint: "章末让天启文书反压边地旧驿，推动下一章的抗诏选择。"
}
