beat 闻人强牵残简 @ structure.vol01.ch76 {
  effect:
    chars.闻人观星.位置 = world.辰月星坛
    chars.闻人观星.状态 = 强牵残简
    world.雷碧城星术残简.状态 = 强牵封门

  pov: chars.苏离灯
  location: world.星文回廊
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  mentions: { chars.闻人观星, world.雷碧城星术残简, world.辰月星坛 }
  render_hint: "闻人隔坛强牵残简，要显出辰月仍想把证据变成星命独占。"
}

beat 星盘裂出反噬 @ structure.vol01.ch76 {
  effect:
    world.十二主星盘.状态 = 反噬裂盘
    chars.闻人观星.状态 = 星局反噬
    world.辰月暗宗.状态 = 星局受挫

  pov: chars.苏离灯
  location: world.星文回廊
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜 }
  advances: { threads.辰月暗流线, threads.九州野史线 }
  reveals: world.秘术溢出风险
