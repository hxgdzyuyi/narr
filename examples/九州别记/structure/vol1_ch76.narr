  render_hint: "反噬要来自秘术越界和证据链不受星命独占，不是简单法术失败。"
}

beat 雷碧城旧影入证 @ structure.vol01.ch76 {
  effect:
    world.雷碧城.状态 = 辰月旧影入证
    chars.殷折.知道 += world.雷碧城辰月国师
    chars.牧云镜.知道 += world.离国辰月牵连

  pov: chars.牧云镜
  location: world.星文回廊
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.辰月暗流线, threads.九州野史线, threads.大墓真相线 }
  reveals: { world.雷碧城辰月国师, world.离国辰月牵连 }
  mentions: { world.雷碧城, world.雷碧城星术残简, world.离国国师府 }
  render_hint: "雷碧城在这里成为旧史证据，不再作为辰月神谕。"
}

