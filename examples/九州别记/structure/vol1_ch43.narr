namespace 九州别记.structure.vol1_ch43

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 残片照出离公称谓 @ structure.vol01.ch43 {
  effect:
    chars.殷折.位置 = world.墓志石室
    chars.殷折.状态 = 重嵌墓志残片
    world.离公墓志残片.状态 = 离公称谓显

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.苏离灯 }
  advances: { threads.大墓真相线, threads.封陵旧史线 }
  reveals: world.嬴无翳为离公
  mentions: { world.离公墓志残片, world.墓志石室, world.嬴无翳 }
  render_hint: "残片只显出离公称谓，不能在这一拍直接写出完整墓主名。"
}

beat 空缺避开真名 @ structure.vol01.ch43 {
  effect:
    world.离公墓志残片.状态 = 缺名避真
    world.无名战牍残页.状态 = 缺名互照
    world.疑似封陵.状态 = 遮名加重

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折 }
  advances: { threads.封陵旧史线, threads.九州野史线 }
  mentions: { world.无名战牍残页, world.空棺无名事实, world.牧云掩史旧档 }
  render_hint: "缺名要像有意遮蔽，不像残片自然残破。"
}

beat 苏离灯辨誓禁王骨 @ structure.vol01.ch43 {
  effect:
    chars.苏离灯.位置 = world.墓志石室
    chars.苏离灯.状态 = 辨出誓禁王骨
    chars.苏离灯.知道 += world.天驱护陵旧誓
    world.旧鹰扳指.状态 = 誓禁王骨

  pov: chars.苏离灯
  location: world.墓志石室
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜 }
  advances: { threads.天驱旧誓线, threads.大墓真相线 }
  mentions: { world.旧鹰扳指, world.天驱护陵旧誓, world.天驱旧盟 }
  render_hint: "苏离灯只辨出旧誓禁语，不能让天驱线夺走墓主确认。"
}

beat 牧云镜见正史裁剪 @ structure.vol01.ch43 {
  effect:
    chars.牧云镜.状态 = 见正史裁剪
    chars.牧云镜.知道 += world.嬴无翳未帝而霸
    world.殇阳关战牍.状态 = 缺名受裁

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.穆如砚, chars.殷折 }
  advances: { threads.端朝皇权线, threads.九州野史线, threads.封陵旧史线 }
  reveals: world.嬴无翳未帝而霸
  mentions: { world.端朝, world.嬴无翳未帝而霸, world.殇阳关战牍 }
  render_hint: "正史裁剪要让牧云镜意识到问题不是某个名字缺失，而是旧史结构被修过。"
}

beat 丁缺金借缺名索价 @ structure.vol01.ch43 {
  effect:
    chars.丁缺金.状态 = 借缺名索价
    chars.丁缺金.位置 = world.墓志石室
    world.离公墓志残片.状态 = 离公称谓显

  pov: chars.丁缺金
  location: world.墓志石室
  on_screen: true
  observers: { chars.丁缺金, chars.殷折, chars.苏离灯 }
  advances: { threads.摸金门规线, threads.辰月暗流线 }
  mentions: { world.离公墓志残片, world.辰月暗宗, world.摸金殷门 }
  render_hint: "丁缺金把缺名当筹码，反衬主角团不能把证据当货物。"
}
