namespace 九州别记.structure.vol1_ch07

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 鹰戒牵入铁誓侧廊 @ structure.vol01.ch07 {
  effect:
    chars.苏离灯.位置 = world.地下铁誓厅
    chars.殷折.位置 = world.地下铁誓厅
    chars.洛衡.位置 = world.地下铁誓厅
    chars.苏离灯.状态 = 旧誓震动
    world.旧鹰扳指.状态 = 烫裂

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.洛衡 }
  advances: { threads.天驱旧誓线, threads.误入地宫线 }
  mentions: { world.地下铁誓厅, world.旧鹰扳指 }
  render_hint: "铁誓厅由扳指和侧廊机关引出，不要让众人主动寻宝。"
}

beat 铁痕照出旧誓 @ structure.vol01.ch07 {
  effect:
    chars.苏离灯.知道 += world.天驱旧誓残痕
    chars.殷折.知道 += world.天驱旧誓残痕
    world.地下铁誓厅.状态 = 誓痕显现

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.大墓真相线 }
  reveals: world.天驱旧誓残痕
  mentions: { world.天驱旧盟, world.地下铁誓厅 }
  render_hint: "铁痕证明旧誓曾在此处留下残影，不证明天驱建造地宫。"
}

beat 苏离灯读出断名 @ structure.vol01.ch07 {
  effect:
    chars.苏离灯.状态 = 认出断名
    chars.苏离灯.arc_state = 守誓而疑誓
    chars.苏离灯.相信 += "旧誓被人故意截断"

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  mentions: { world.地下铁誓厅, world.天驱旧盟 }
  render_hint: "断名要推动苏离灯的怀疑，而不是给出完整答案。"
}

beat 姬断鹰隔门逼誓 @ structure.vol01.ch07 {
  effect:
    chars.姬断鹰.位置 = world.地下铁誓厅
    chars.姬断鹰.状态 = 隔门逼誓
    chars.姬断鹰.知道 += world.天驱旧誓残痕
    chars.苏离灯.关系 += "被姬断鹰隔门逼认旧誓"

  pov: chars.姬断鹰
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.姬断鹰, chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.辰月暗流线 }
  mentions: { world.天驱旧盟, world.地下铁誓厅 }
  render_hint: "姬断鹰只逼誓和夺解释权，不在此处展开完整身世。"
}

beat 众人熄灯退回外城 @ structure.vol01.ch07 {
  effect:
    chars.苏离灯.位置 = world.封陵外城
    chars.殷折.位置 = world.封陵外城
    chars.洛衡.位置 = world.封陵外城
    chars.姬断鹰.状态 = 追索旧誓
    world.旧鹰扳指.状态 = 裂纹未断

  pov: chars.殷折
  location: world.封陵外城
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.洛衡 }
  advances: { threads.误入地宫线, threads.摸金门规线, threads.天驱旧誓线 }
  mentions: { world.封陵外城, world.地下铁誓厅 }
  render_hint: "退回外城是保存火种和队形，不是结束天驱线。"
}
