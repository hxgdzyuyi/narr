namespace 九州别记.structure.vol1_ch63

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 断名照出守誓原义 @ structure.vol01.ch63 {
  effect:
    chars.苏离灯.知道 += world.天驱护陵旧誓
    world.地下铁誓厅.状态 = 守誓原义显现
    world.旧鹰扳指.状态 = 照见断名

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.大墓真相线 }
  reveals: world.天驱护陵旧誓
  mentions: { world.天驱旧誓残痕, world.地下铁誓厅, world.旧鹰扳指 }
  render_hint: "断名要回到护陵旧誓的残缺语义，不写成完整天驱法典。"
}

beat 鹰旗残绶不肯归宗 @ structure.vol01.ch63 {
  effect:
    world.鹰旗残绶.状态 = 拒归夺权
    chars.姬断鹰.状态 = 旧宗不认
    chars.苏离灯.知道 += world.天驱鹰旗召集

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.姬断鹰 }
  advances: threads.天驱旧誓线
  reveals: world.天驱鹰旗召集
  mentions: { world.鹰旗残绶, world.天驱旧盟 }
  render_hint: "鹰旗残绶要拒绝被姬断鹰拿来召集，不直接给苏离灯号令权。"
}

beat 苏离灯分开守誓与夺权 @ structure.vol01.ch63 {
  effect:
    chars.苏离灯.arc_state = 分辨守誓夺权
    chars.苏离灯.相信 += "守誓是护证护人，夺权是借誓号令。"
    world.旧鹰扳指.状态 = 分辨守誓夺权

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.姬断鹰 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  mentions: { world.旧鹰扳指, world.天驱护陵旧誓 }
  render_hint: "这一步要靠苏离灯的判断完成，不靠外部权威替她裁决。"
}

beat 旧鹰扳指暂稳 @ structure.vol01.ch63 {
  effect:
    world.旧鹰扳指.状态 = 暂稳守誓
    chars.苏离灯.状态 = 暂稳旧誓
    world.地下铁誓厅.状态 = 旧誓暂稳

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.摸金门规线 }
  mentions: { world.旧鹰扳指, world.地下铁誓厅 }
  render_hint: "暂稳只是给下一步选择争取时间，不是彻底解决旧誓。"
}

beat 姬断鹰改以星局施压 @ structure.vol01.ch63 {
  effect:
    chars.姬断鹰.状态 = 转借星局施压
    world.十二主星盘.状态 = 旧誓受压
    world.雷碧城星术残简.状态 = 牵扯旧誓

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.姬断鹰, chars.闻人观星 }
  advances: { threads.天驱旧誓线, threads.辰月暗流线, threads.大墓真相线 }
  mentions: { world.十二主星盘, world.雷碧城星术残简, world.天驱旧盟 }
  render_hint: "章末把姬断鹰和闻人观星的利益临时绑在一起。"
}
