import 九州别记.threads as threads
import 九州别记.promises as promises

beat 牧云镜校残牍 @ structure.vol01.ch53 {
  effect:
    chars.牧云镜.位置 = world.墓志石室
    chars.牧云镜.状态 = 校对残牍
    chars.牧云镜.知道 += world.九州别记朝代用法
    world.殇阳关战牍.状态 = 史官复校

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折 }
  advances: { threads.九州野史线, threads.封陵旧史线 }
  reveals: world.九州别记朝代用法
  mentions: { world.殇阳关战牍, world.离公墓志残片, world.牧云掩史旧档 }
  render_hint: "复校要把墓志、战牍和旧档互相校正，不靠口号抗诏。"
}

beat 史官副录分藏 @ structure.vol01.ch53 {
  effect:
    chars.牧云镜.状态 = 分藏副录
    chars.牧云镜.相信 += "副录必须先于正本被夺走前流出"
    world.殇阳关战牍.状态 = 留出副录

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.九州野史线, threads.端朝皇权线 }
  mentions: { world.牧云掩史旧档, world.端朝掩史司, world.旧鹰扳指 }
  render_hint: "副录分藏是具体行动，表现她从两难走向抗诏。"
}

beat 殷折守残片不交 @ structure.vol01.ch53 {
  effect:
    chars.殷折.位置 = world.墓志石室
    chars.殷折.状态 = 守残片不交
    world.离公墓志残片.状态 = 拒交掩史司

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.牧云烬 }
  advances: { threads.摸金门规线, threads.大墓真相线 }
  mentions: { world.离公墓志残片, world.端朝掩史司, world.殷门罗盘 }
  render_hint: "殷折守证是守门规和活人，不是抢夺历史解释权。"
}

beat 牧云镜拒改墓主名 @ structure.vol01.ch53 {
  effect:
    chars.牧云镜.状态 = 拒改墓主名
    chars.牧云镜.arc_state = 留史抗诏
    chars.牧云烬.状态 = 逼改墓主口径

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.牧云烬, chars.穆如砚 }
  advances: { threads.九州野史线, threads.端朝皇权线 }
  mentions: { world.嬴无翳, world.嬴无翳墓主定位, world.端朝掩史司 }
  render_hint: "拒改名要具体到不把嬴无翳改成可供端朝摆布的符号。"
}

beat 野史线立暗簿 @ structure.vol01.ch53 {
  effect:
    chars.牧云镜.状态 = 暗簿初立
    chars.殷折.知道 += world.嬴无翳墓葬危险原则
    world.殇阳梦境残印.状态 = 入暗簿

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.九州野史线, threads.大墓真相线 }
  reveals: world.嬴无翳墓葬危险原则
  mentions: { world.殇阳梦境残印, world.张博断刃, world.无名战牍残页 }
  render_hint: "暗簿不是新设定，而是把已有梦印和残证纳入野史保存。"
}
