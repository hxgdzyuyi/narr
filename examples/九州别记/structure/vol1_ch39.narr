beat 牧云烬分裂牧云令 @ structure.vol01.ch39 {
  effect:
    chars.牧云烬.位置 = world.墓志石室
    chars.牧云烬.状态 = 分裂牧云令
    world.端室牧云氏.状态 = 内部分裂
    world.端朝掩史司.状态 = 内斗夺证

  pov: chars.牧云烬
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云烬, chars.牧云镜, chars.穆如砚, chars.殷折 }
  advances: { threads.端朝皇权线, threads.大墓真相线 }
  mentions: { world.端室牧云氏, world.端朝掩史司, world.端末盟约破裂 }
  render_hint: "牧云烬的内斗压力来自牧云氏内部夺证，不要让他变成单线反派。"
}

beat 牧云镜押证抗命 @ structure.vol01.ch39 {
  effect:
    chars.牧云镜.状态 = 押证抗命
    chars.牧云镜.关系 += "以史官身份拒绝交出唯一原证"
    world.殇阳关战牍.状态 = 押证抗命

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.牧云烬, chars.穆如砚, chars.殷折 }
  advances: { threads.端朝皇权线, threads.九州野史线, threads.封陵旧史线 }
  mentions: { world.殇阳关战牍, world.牧云掩史旧档, world.掩史司密库 }
  render_hint: "押证抗命要把她的风险写清，不要写成已掌握全部真相。"
}

beat 丁缺金卖门被弃 @ structure.vol01.ch39 {
