beat 马具残饰排出旧制 @ structure.vol01.ch36 {
  effect:
    world.离国马具残饰.状态 = 军制入证
    world.赤旅兵冢.状态 = 军制露骨
    chars.洛衡.知道 += world.离国军工痕迹

  pov: chars.洛衡
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.洛衡, chars.殷折, chars.牧云镜 }
  advances: { threads.大墓真相线, threads.九州野史线 }
  reveals: world.离国军工痕迹
  mentions: { world.离国马具残饰, world.赤旅兵冢, world.离国铁骑 }
  render_hint: "马具残饰要被当作制式证据，不写成华丽陪葬物。"
}

beat 洛衡识出赤旅铸痕 @ structure.vol01.ch36 {
  effect:
    chars.洛衡.状态 = 识出赤旅铸痕
    chars.洛衡.相信 += "赤旅铸痕比墓葬纹饰更接近军工"
    world.离国赤旅.状态 = 铸痕待证

  pov: chars.洛衡
  location: world.赤旅兵冢
  on_screen: true
  observers: { chars.洛衡, chars.殷折, chars.牧云镜 }
  advances: { threads.大墓真相线, threads.封陵旧史线 }
  reveals: world.离国军工痕迹
  mentions: { world.离国赤旅, world.河络地火工艺, world.赤旅兵冢 }
  render_hint: "洛衡只能从铸痕和机关逻辑辨出军工，不直接替史官确认墓主。"
}

beat 牧云镜对照军政 @ structure.vol01.ch36 {
  effect:
    chars.牧云镜.状态 = 对照离国军政
