  mentions: { world.嬴无翳用人与军政, world.离国赤旅, world.殇阳关战牍 }
  render_hint: "军政对照应增加危险性，但要明确仍是证据链一环。"
}

beat 牧云烬改称官证 @ structure.vol01.ch36 {
  effect:
    chars.牧云烬.状态 = 改称官证
