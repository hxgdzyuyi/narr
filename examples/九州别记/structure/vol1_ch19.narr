import 九州别记.promises as promises

beat 殷折醒在离军阵前 @ structure.vol01.ch19 {
  effect:
    chars.殷折.位置 = world.梦中殇阳雨阵
    chars.殷折.状态 = 醒在离军阵前
    world.梦中殇阳雨阵.状态 = 战前雨阵

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.大墓真相线 }
  mentions: { world.梦中殇阳雨阵, world.离国铁骑, world.殇阳关 }
  render_hint: "殷折醒来时要先感到身体和军阵都不属于自己。"
}

beat 白毅军势压关 @ structure.vol01.ch19 {
  effect:
    world.白毅.位置 = world.梦中殇阳雨阵
    world.白毅.状态 = 军势压关
    chars.殷折.知道 += world.殇阳关战役事实

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.九州野史线, threads.殇阳梦境线 }
  mentions: { world.白毅, world.楚卫国, world.殇阳关联军 }
  render_hint: "白毅军势是战史压力，不要把对手写成单薄反派。"
}

beat 雷碧城星术污染战牍 @ structure.vol01.ch19 {
  effect:
    world.雷碧城.位置 = world.梦中殇阳雨阵
    world.雷碧城.状态 = 星术污染战牍
    chars.殷折.知道 += world.殇阳关异变之夜
    world.殇阳关战牍.状态 = 梦中受污

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.辰月暗流线, threads.殇阳梦境线 }
  reveals: world.殇阳关异变之夜
  mentions: { world.雷碧城, world.殇阳关战牍, world.雷碧城辰月支 }
  render_hint: "雷碧城的星术污染解释缺名风险，不要把梦境写成单纯幻术。"
}

beat 殷折试改败局受限 @ structure.vol01.ch19 {
  effect:
    chars.殷折.状态 = 改局受限
    chars.殷折.知道 += world.梦境挽回边界
    world.梦中殇阳雨阵.状态 = 战局未改

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.摸金门规线 }
  reveals: world.梦境挽回边界
  mentions: { world.梦境挽回边界, world.殇阳关战役事实 }
  render_hint: "让殷折主动试图改变败局再被边界压回，明确梦境规则。"
}

beat 张博断刃指名 @ structure.vol01.ch19 {
  effect:
    world.张博断刃.状态 = 引向缺名
    world.无名战牍残页.状态 = 缺名发黑
    chars.殷折.知道 += world.墓主遗憾核心

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.九州野史线 }
  mentions: { world.张博断刃, world.无名战牍残页, world.张博 }
  render_hint: "断刃指向的是姓名和收殓任务，不是再打一场胜仗。"
}
