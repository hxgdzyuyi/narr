beat 雨阵退成战牍 @ structure.vol01.ch29 {
  effect:
    world.梦中殇阳雨阵.状态 = 退成战牍纹
    world.殇阳关战牍.状态 = 梦中复成战牍
    chars.殷折.状态 = 看见雨阵退潮

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.九州野史线 }
  mentions: { world.梦中殇阳雨阵, world.殇阳关战牍, world.殇阳关梦境 }
  render_hint: "雨阵退成文字纹路，提示梦境将回到现实证物。"
}

beat 殷折不追胜负 @ structure.vol01.ch29 {
  effect:
    chars.殷折.状态 = 不追胜负幻影
    chars.殷折.知道 += world.梦境挽回边界
    world.殇阳关梦境.状态 = 胜负幻影退去

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.摸金门规线, threads.殇阳梦境线 }
  reveals: world.梦境挽回边界
  mentions: { world.梦境挽回边界, world.殇阳关战役事实, world.殇阳关梦境 }
  render_hint: "这是殷折的选择确认，不是梦境替他关掉所有诱惑。"
}

beat 突围因果闭合 @ structure.vol01.ch29 {
  effect:
    world.梦中殇阳雨阵.状态 = 突围因果已闭
    world.嬴无翳.状态 = 突围因果已闭
    world.殇阳关战牍.状态 = 败局未改群名留存

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.大墓真相线, threads.九州野史线 }
  reveals: world.殇阳关战役事实
  mentions: { world.嬴无翳, world.殇阳关战牍, world.梦境挽回边界 }
  render_hint: "突围因果闭合时要确认败局没有改写，只有姓名被留住。"
}

beat 无名残页群名初成 @ structure.vol01.ch29 {
  effect:
    world.无名战牍残页.状态 = 群名初成
    world.殇阳梦境残印.状态 = 群名待返
    chars.殷折.状态 = 带群名至梦门

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
