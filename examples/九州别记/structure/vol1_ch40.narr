beat 赤旅暗匣出刀铭 @ structure.vol01.ch40 {
  effect:
    chars.殷折.位置 = world.疑似离公墓域
    chars.牧云镜.位置 = world.疑似离公墓域
    chars.穆如砚.位置 = world.疑似离公墓域
    world.赤旅兵冢.状态 = 暗匣开出
    world.霸刀断铭.状态 = 出土未证
    world.霸刀遗名.状态 = 断铭相照
    chars.殷折.知道 += world.嬴无翳骑射霸刀

  pov: chars.殷折
  location: world.疑似离公墓域
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.穆如砚, chars.苏离灯 }
  advances: { threads.大墓真相线, threads.九州野史线 }
  reveals: world.嬴无翳骑射霸刀
  mentions: { world.霸刀断铭, world.霸刀遗名, world.赤旅兵冢 }
  render_hint: "霸刀断铭可以出土，但必须立刻标记为未证，不能直接坐实墓主。"
}

beat 离国军制互证 @ structure.vol01.ch40 {
  effect:
    world.离国马具残饰.状态 = 与断铭互证
    world.离国赤旅.状态 = 军制证据出土
    world.疑似离公墓域.状态 = 主墓将明
    chars.牧云镜.知道 += world.嬴无翳用人与军政

  pov: chars.牧云镜
  location: world.疑似离公墓域
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.洛衡 }
  advances: { threads.大墓真相线, threads.九州野史线, threads.封陵旧史线 }
  reveals: world.嬴无翳用人与军政
  mentions: { world.离国马具残饰, world.离国赤旅, world.嬴无翳用人与军政 }
  render_hint: "军制互证只能把证据链补强，不替墓志主名盖棺。"
}

