namespace 九州别记.structure.vol1_ch74

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 牧云镜拒进密库 @ structure.vol01.ch74 {
  effect:
    chars.牧云镜.状态 = 拒绝独占
    world.殇阳关战牍.状态 = 野史副本
    world.端朝掩史司.状态 = 夺史受阻

  pov: chars.牧云镜
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云镜, chars.牧云烬, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.九州野史线 }
  reveals: world.牧云掩史旧档
  mentions: { world.掩史司密库, world.殇阳关战牍, world.端朝掩史司 }
  render_hint: "牧云镜拒绝的是独占路径，不是拒绝记录本身。"
}

beat 穆如砚压下军令 @ structure.vol01.ch74 {
  effect:
    chars.穆如砚.状态 = 违令护证
    world.穆如旧令抄本.状态 = 与墓志互证
    chars.牧云镜.知道 += world.穆如封陵军令抄本

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜 }
  advances: { threads.穆如军门线, threads.封陵旧史线 }
  mentions: { world.穆如旧令抄本, world.穆如封陵军令抄本, world.牧云穆如盟约 }
  render_hint: "军令抄本要成为互证材料，不再只是穆如私藏压力。"
}

beat 苏离灯留鹰戒印 @ structure.vol01.ch74 {
  effect:
    world.旧鹰扳指.状态 = 留誓为证
    chars.苏离灯.状态 = 留誓不夺
    chars.苏离灯.arc_state = 守誓留证

  pov: chars.苏离灯
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  mentions: { world.旧鹰扳指, world.天驱护陵旧誓, world.天驱旧盟 }
  render_hint: "鹰戒印只证明天驱旧誓曾被触动，不让天驱独占封陵解释权。"
}

beat 草原口传补入旁证 @ structure.vol01.ch74 {
  effect:
    chars.硕风照夜.状态 = 补入旧歌
    world.夸父骨画拓本.状态 = 口传相照
    chars.硕风照夜.相信 += "吞狼旧歌可以替无名者作旁证。"

  pov: chars.硕风照夜
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.硕风照夜, chars.牧云镜 }
  advances: { threads.瀚州草原线, threads.九州野史线 }
  mentions: { world.硕风吞狼旧歌, world.夸父骨画拓本, world.多族痕迹解释原则 }
  render_hint: "草原口传要进入证据链，不当作点缀性的异族传说。"
}

beat 殷折分藏三证 @ structure.vol01.ch74 {
  effect:
    chars.殷折.状态 = 分证不夺
    world.离公墓志残片.状态 = 留史分证
    world.殇阳关战牍.状态 = 分证可追

  pov: chars.殷折
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.苏离灯, chars.穆如砚 }
  advances: { threads.九州野史线, threads.大墓真相线, threads.摸金门规线 }
  mentions: { world.离公墓志残片, world.殇阳关战牍, world.雷碧城星术残简 }
  render_hint: "分藏三证要保证后来能追索，也防止皇权、辰月或主角团自己独占。"
}
