namespace 九州别记.structure.vol1_ch10

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 墓志石室露缝 @ structure.vol01.ch10 {
  effect:
    chars.殷折.位置 = world.墓志石室
    chars.牧云镜.位置 = world.墓志石室
    chars.穆如砚.位置 = world.墓志石室
    chars.苏离灯.位置 = world.墓志石室
    world.墓志石室.状态 = 半开

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.穆如砚, chars.苏离灯 }
  advances: { threads.误入地宫线, threads.大墓真相线 }
  mentions: { world.墓志石室, world.疑似离公墓域 }
  render_hint: "石室露缝像答案将出，但仍要保留遮蔽。"
}

beat 离公残片出土 @ structure.vol01.ch10 {
  effect:
    world.离公墓志残片.状态 = 残片出土
    chars.牧云镜.知道 += world.空棺无名事实
    chars.牧云镜.知道 += world.离国军工痕迹
    chars.殷折.知道 += world.离国军工痕迹

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.穆如砚 }
  sets_up: promises.殇阳梦境伏笔
  advances: { threads.大墓真相线, threads.九州野史线, threads.封陵旧史线 }
  mentions: { world.离公墓志残片, world.疑似离公墓域, world.离国 }
  render_hint: "残片只能写出离公相关疑云，不能写出嬴无翳墓主确认。"
}

beat 牧云烬夺证封口 @ structure.vol01.ch10 {
  effect:
    chars.牧云烬.位置 = world.墓志石室
    chars.牧云烬.状态 = 夺证封口
    chars.牧云烬.知道 += world.空棺无名事实
    world.离公墓志残片.状态 = 被官府争夺

  pov: chars.牧云烬
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云烬, chars.殷折, chars.牧云镜, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.大墓真相线 }
  mentions: { world.端朝掩史司, world.离公墓志残片 }
  render_hint: "牧云烬要夺的是解释权和证物，不是完整真相。"
}

beat 穆如砚违令护队 @ structure.vol01.ch10 {
  effect:
    chars.穆如砚.状态 = 违令护队
    chars.穆如砚.arc_state = 奉命而疑命
    chars.穆如砚.关系 += "违背封口命令护住队伍"

  pov: chars.穆如砚
  location: world.墓志石室
  on_screen: true
  observers: { chars.穆如砚, chars.殷折, chars.牧云镜, chars.牧云烬 }
  advances: { threads.穆如军门线, threads.端朝皇权线, threads.摸金门规线 }
  mentions: { world.穆如军门, world.端朝掩史司 }
  render_hint: "违令要落在保护活人和证物上，不写成单纯倒戈。"
}

beat 殷折藏片立规 @ structure.vol01.ch10 {
  effect:
    chars.殷折.状态 = 藏片守规
    chars.殷折.arc_state = 守规担责
    chars.殷折.知道 += world.空棺无名事实
    chars.丁缺金.状态 = 露出背门
    world.离公墓志残片.状态 = 由殷折藏存
    world.疑似封陵.状态 = 墓主未证
    world.疑似离公墓域.状态 = 墓主待证

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.牧云镜, chars.穆如砚, chars.苏离灯 }
  advances: { threads.大墓真相线, threads.摸金门规线, threads.九州野史线 }
  mentions: { world.离公墓志残片, world.殷门罗盘, world.疑似离公墓域 }
  render_hint: "殷折藏片是为了保留真相和活人，不是私吞。"
}
