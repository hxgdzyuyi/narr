import 九州别记.threads as threads
import 九州别记.promises as promises

beat 掩史司封住石室 @ structure.vol01.ch32 {
  effect:
    chars.牧云烬.位置 = world.墓志石室
    chars.牧云烬.状态 = 封口夺证
    world.端朝掩史司.状态 = 封口夺证
    world.墓志石室.状态 = 围困加压

  pov: chars.牧云烬
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云烬, chars.殷折, chars.牧云镜, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.大墓真相线 }
  mentions: { world.端朝掩史司, world.掩史司密库, world.离公墓志残片 }
  render_hint: "封口要表现为封解释权和证物流向，不写成单纯武力清场。"
}

beat 牧云镜拒交战牍 @ structure.vol01.ch32 {
  effect:
    chars.牧云镜.状态 = 护牍抗诏
    chars.牧云镜.相信 += "原证必须在多人见证下保存"
    world.殇阳关战牍.状态 = 史官护存
    world.离公墓志残片.状态 = 史官见证

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.牧云烬, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.封陵旧史线, threads.九州野史线 }
  mentions: { world.殇阳关战牍, world.牧云掩史旧档, world.离公墓志残片 }
  render_hint: "牧云镜抗诏不是造反口号，而是史官对原证的最低保护。"
}

beat 穆如砚拆分人证物证 @ structure.vol01.ch32 {
  effect:
    chars.穆如砚.状态 = 分护人证
    chars.穆如砚.关系 += "把伤者与原证分线护送"
    chars.牧云镜.关系 += "暂信穆如砚护证"

  pov: chars.穆如砚
  location: world.墓志石室
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.殷折 }
  advances: { threads.穆如军门线, threads.摸金门规线, threads.端朝皇权线 }
  mentions: { world.穆如军门, world.穆如旧令抄本, world.墓志石室 }
  render_hint: "拆分要体现军门处置危局的效率，同时保留他仍在违令边缘。"
}

beat 殷折以罗盘护片 @ structure.vol01.ch32 {
  effect:
    chars.殷折.状态 = 以罗盘护片
    chars.殷折.arc_state = 守证救人
    world.殷门罗盘.状态 = 护片定路
    world.离公墓志残片.状态 = 罗盘压痕

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜 }
  advances: { threads.摸金门规线, threads.大墓真相线 }
  mentions: { world.殷门罗盘, world.离公墓志残片, world.殷氏罗盘旧训 }
  render_hint: "罗盘护片要回到保命和辨路功能，不写成压制一切秘术的神器。"
}

beat 石室围困逼向回廊 @ structure.vol01.ch32 {
  effect:
    chars.殷折.位置 = world.星文回廊
    chars.牧云镜.位置 = world.星文回廊
