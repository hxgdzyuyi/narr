import 九州别记.threads as threads
import 九州别记.promises as promises

beat 旧驿迁民出雪 @ structure.vol01.ch55 {
  effect:
    chars.穆如砚.位置 = world.雪炽原旧驿
    chars.穆如砚.状态 = 迁民出雪
    world.穆如军门.状态 = 迁民出雪

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.殷折 }
  advances: { threads.穆如军门线, threads.误入地宫线 }
  mentions: { world.雪炽原旧驿, world.殇州流放道, world.穆如军门 }
  render_hint: "迁民要有道路、风雪和军户压力，避免空泛说护民。"
}

beat 掩史骑卒围驿 @ structure.vol01.ch55 {
  effect:
    chars.牧云烬.位置 = world.雪炽原旧驿
    chars.牧云烬.状态 = 围驿封口
    world.端朝掩史司.状态 = 围驿封口

  pov: chars.牧云烬
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云烬, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.穆如军门线 }
  mentions: { world.雪炽原旧驿, world.端朝掩史司, world.嬴无翳墓葬危险原则 }
  render_hint: "围驿是封口行动的物理压力，和上一章文书反证相接。"
}

beat 穆如砚抗令开道 @ structure.vol01.ch55 {
  effect:
    chars.穆如砚.状态 = 抗令开道
    chars.穆如砚.关系 += "以军门阵列护送边民过雪"
    world.穆如军门.状态 = 开道撤民

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云烬, chars.牧云镜 }
  advances: { threads.穆如军门线, threads.端朝皇权线 }
  mentions: { world.穆如军门, world.北陆草原与冰原, world.雪炽原 }
  render_hint: "抗令先表现为开路护民，还不是公开叛旗。"
}

beat 牧云烬记军门逆名 @ structure.vol01.ch55 {
  effect:
    chars.牧云烬.状态 = 记军门逆名
    world.端朝掩史司.状态 = 记录军门逆名
    world.穆如军门.状态 = 被列逆名

  pov: chars.牧云烬
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.牧云烬, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.穆如军门线 }
  mentions: { world.端朝掩史司, world.穆如军门, world.端末东西分裂 }
  render_hint: "牧云烬把护民动作改写成逆名，为第六十章夺局加码。"
}

beat 军门护民成势 @ structure.vol01.ch55 {
  effect:
    chars.穆如砚.状态 = 护民抗令
    chars.穆如砚.arc_state = 护民疑诏
    world.穆如军门.状态 = 护民抗令

  pov: chars.穆如砚
  location: world.雪炽原旧驿
  on_screen: true
  observers: { chars.穆如砚, chars.牧云镜, chars.殷折 }
  advances: { threads.穆如军门线, threads.九州野史线 }
  mentions: { world.穆如军门, world.雪炽原旧驿, world.殇州流放道 }
  render_hint: "章末状态必须落在护民疑诏，留出后续公开违诏。"
}
