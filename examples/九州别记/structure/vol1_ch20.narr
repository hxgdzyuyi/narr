namespace 九州别记.structure.vol1_ch20

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 殷折追至死阵 @ structure.vol01.ch20 {
  effect:
    chars.殷折.位置 = world.梦中殇阳雨阵
    chars.殷折.状态 = 追至死阵
    world.梦中殇阳雨阵.状态 = 死阵显现

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.误入地宫线 }
  mentions: { world.梦中殇阳雨阵, world.张博断刃 }
  render_hint: "追至死阵要写成循名与循刃，不写成追逐宝物。"
}

beat 张博姓名浮现 @ structure.vol01.ch20 {
  effect:
    world.张博.状态 = 梦中归名
    world.无名战牍残页.状态 = 张博归名
    chars.殷折.知道 += world.张博殇阳战死

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  pays_off: promises.张博归名伏笔
  advances: { threads.殇阳梦境线, threads.九州野史线 }
  reveals: world.张博殇阳战死
  mentions: { world.张博, world.无名战牍残页, world.殇阳关战牍 }
  render_hint: "姓名浮现是本章情感兑现点，但不等于战局逆转。"
}

beat 墓主不能回军 @ structure.vol01.ch20 {
  effect:
    chars.殷折.状态 = 受限不能回军
    chars.殷折.知道 += world.墓主遗憾核心
    chars.殷折.知道 += world.梦境挽回边界
    world.梦中殇阳雨阵.状态 = 败局仍在

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.大墓真相线 }
  reveals: { world.墓主遗憾核心, world.梦境挽回边界 }
  mentions: { world.嬴无翳, world.殇阳关战役事实 }
  render_hint: "墓主不能回军要让殷折明白遗憾的边界，而不是放弃行动。"
}

beat 殷折收殓断刃 @ structure.vol01.ch20 {
  effect:
    chars.殷折.状态 = 收殓断刃
    chars.殷折.arc_state = 守规问史
    world.张博断刃.状态 = 已归名
    world.梦中殇阳雨阵.状态 = 归名未改史

  pov: chars.殷折
  location: world.梦中殇阳雨阵
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.摸金门规线, threads.殇阳梦境线, threads.九州野史线 }
  mentions: { world.张博断刃, world.摸金殷门 }
  render_hint: "收殓断刃把殷门门规带进梦境，不是现代人强行改写古战。"
}

beat 梦印反写残片 @ structure.vol01.ch20 {
  effect:
    world.殇阳梦境残印.状态 = 归名初成
    world.离公墓志残片.状态 = 反写归名
    chars.殷折.位置 = world.殇阳关梦境
    chars.殷折.状态 = 带名退回梦门

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.大墓真相线, threads.九州野史线 }
  mentions: { world.殇阳梦境残印, world.离公墓志残片, world.墓志石室 }
  render_hint: "梦印只反写一处归名痕迹，为后续梦境留下继续推进的空间。"
}
