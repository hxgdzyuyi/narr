  pov: chars.牧云烬
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云烬, chars.殷折, chars.牧云镜, chars.穆如砚 }
  advances: { threads.端朝皇权线, threads.大墓真相线 }
  mentions: { world.端朝掩史司, world.离公墓志残片, world.掩史司密库 }
  render_hint: "牧云烬看见的是政治和证物价值，不是突然理解梦境全貌。"
}

beat 丁缺金暗记退价 @ structure.vol01.ch31 {
  effect:
    chars.丁缺金.位置 = world.墓志石室
