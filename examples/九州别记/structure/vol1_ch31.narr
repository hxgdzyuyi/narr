beat 殷折醒回石室 @ structure.vol01.ch31 {
  effect:
    chars.殷折.位置 = world.墓志石室
    chars.殷折.身份 = 摸金后人
    chars.殷折.状态 = 梦醒持证
    chars.殷折.知道 += world.墓主遗憾核心
    world.墓志石室.状态 = 梦醒反压
    world.殇阳关梦境.状态 = 余波未散

  pov: chars.殷折
  location: world.墓志石室
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜, chars.穆如砚 }
  advances: { threads.殇阳梦境线, threads.摸金门规线 }
  mentions: { world.墓志石室, world.殇阳关梦境, world.殷门罗盘 }
  render_hint: "醒回现实要有身体错位和门规压身感，但不要让梦境答案直接替代实证。"
}

beat 梦印反写残片 @ structure.vol01.ch31 {
  effect:
    world.殇阳梦境残印.状态 = 反写现实
    world.离公墓志残片.状态 = 反写醒痕
    world.殇阳关战牍.状态 = 反写相照
    world.雷碧城星术残简.状态 = 余星未灭
    chars.牧云镜.知道 += world.梦境挽回边界

  pov: chars.牧云镜
  location: world.墓志石室
  on_screen: true
  observers: { chars.牧云镜, chars.殷折, chars.苏离灯 }
  advances: { threads.殇阳梦境线, threads.大墓真相线, threads.九州野史线 }
  reveals: world.梦境挽回边界
  mentions: { world.殇阳梦境残印, world.离公墓志残片, world.殇阳关战牍 }
  render_hint: "反写痕迹只证明梦印回到现实证物上，不证明墓主身份已经完成确认。"
}

beat 牧云烬估出证价 @ structure.vol01.ch31 {
  effect:
    chars.牧云烬.位置 = world.墓志石室
