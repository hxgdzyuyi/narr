    world.雷碧城星术残简.状态 = 偏星牵动

  pov: chars.闻人观星
  location: world.星文回廊
  on_screen: true
  observers: { chars.闻人观星, chars.苏离灯, chars.殷折 }
  advances: { threads.辰月暗流线, threads.大墓真相线 }
  reveals: world.辰月主星偏用
  mentions: { world.十二主星盘, world.雷碧城星术残简, world.辰月暗宗 }
  render_hint: "偏用四主星要让星盘显出人为压榨感。"
}

beat 星盘越过承载 @ structure.vol01.ch67 {
  effect:
    world.十二主星盘.状态 = 秘术溢出
    chars.闻人观星.状态 = 星术过载
