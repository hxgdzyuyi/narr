  pov: chars.闻人观星
  location: world.星文回廊
  on_screen: true
  observers: { chars.闻人观星, chars.牧云镜, chars.苏离灯 }
  advances: threads.辰月暗流线
  reveals: world.秘术溢出风险
  mentions: { world.十二主星盘, world.星文观测原则 }
  render_hint: "过载要成为闻人观星自己的代价，不只伤害主角团。"
}

beat 雷碧城残简反噬 @ structure.vol01.ch67 {
  effect:
    world.雷碧城星术残简.状态 = 反噬星局
