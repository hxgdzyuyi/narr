namespace 九州别记.structure.vol1_ch34

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 姬断鹰入铁誓厅 @ structure.vol01.ch34 {
  effect:
    chars.姬断鹰.位置 = world.地下铁誓厅
    chars.姬断鹰.状态 = 入厅索誓
    world.地下铁誓厅.状态 = 断鹰入厅

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.牧云镜, chars.穆如砚, chars.姬断鹰 }
  advances: { threads.天驱旧誓线, threads.大墓真相线 }
  mentions: { world.地下铁誓厅, world.天驱旧盟, world.天驱旧誓残痕 }
  render_hint: "姬断鹰现身要像旧誓逼近现实，不要写成单纯拦路抢货。"
}

beat 旧鹰扳指照出裂誓 @ structure.vol01.ch34 {
  effect:
    chars.苏离灯.状态 = 看见裂誓
    chars.苏离灯.知道 += world.天驱旧誓残痕
    world.旧鹰扳指.状态 = 裂誓明响
    world.地下铁誓厅.状态 = 裂誓照出

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.姬断鹰 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  reveals: world.天驱旧誓残痕
  mentions: { world.旧鹰扳指, world.地下铁誓厅, world.天驱指套制度 }
  render_hint: "裂誓说明天驱内部对旧誓的理解分裂，不把苏离灯和姬断鹰写成同一路。"
}

beat 苏离灯拒交残片 @ structure.vol01.ch34 {
  effect:
    chars.苏离灯.状态 = 拒交残片
    chars.苏离灯.相信 += "旧誓不能替代原证"
    world.离公墓志残片.状态 = 旧誓未夺

  pov: chars.苏离灯
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.苏离灯, chars.殷折, chars.姬断鹰, chars.牧云镜 }
  advances: { threads.天驱旧誓线, threads.大墓真相线, threads.摸金门规线 }
  mentions: { world.离公墓志残片, world.旧鹰扳指, world.天驱护陵旧誓 }
  render_hint: "拒交残片是守证，不是苏离灯否认天驱旧誓。"
}

beat 姬断鹰夺誓索证 @ structure.vol01.ch34 {
  effect:
    chars.姬断鹰.状态 = 夺誓索证
    chars.姬断鹰.知道 += world.天驱人物规划原则
    world.旧鹰扳指.状态 = 被断鹰逼鸣

  pov: chars.姬断鹰
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.姬断鹰, chars.苏离灯, chars.殷折 }
  advances: { threads.天驱旧誓线, threads.九州野史线 }
  mentions: { world.天驱旧盟, world.旧鹰扳指, world.离公墓志残片 }
  render_hint: "姬断鹰的逻辑是以霸道护旧誓，不能写成只为财物。"
}

beat 穆如砚压住内斗 @ structure.vol01.ch34 {
  effect:
    chars.穆如砚.状态 = 压住内斗
    chars.穆如砚.关系 += "以军门阵列隔开苏离灯和姬断鹰"
    world.地下铁誓厅.状态 = 内斗暂止

  pov: chars.穆如砚
  location: world.地下铁誓厅
  on_screen: true
  observers: { chars.穆如砚, chars.苏离灯, chars.殷折, chars.姬断鹰 }
  advances: { threads.穆如军门线, threads.摸金门规线, threads.天驱旧誓线 }
  mentions: { world.穆如军门, world.地下铁誓厅, world.疑似封陵 }
  render_hint: "穆如砚压内斗要服务于护人和护证，不是替任何一派判输赢。"
}
