namespace 九州别记.structure.vol1_ch18

import 九州别记.structure as structure
import 九州别记.world as world
import 九州别记.characters as chars
import 九州别记.threads as threads
import 九州别记.promises as promises

beat 三残同照成环 @ structure.vol01.ch18 {
  effect:
    world.离公墓志残片.状态 = 与战牍同照
    world.殇阳关战牍.状态 = 与残片同照
    world.雷碧城星术残简.状态 = 三残成环
    world.殇阳关梦境.状态 = 映射开启

  pov: chars.殷折
  location: world.星文回廊
  on_screen: true
  observers: { chars.殷折, chars.苏离灯, chars.牧云镜 }
  pays_off: promises.星术触梦伏笔
  advances: { threads.殇阳梦境线, threads.辰月暗流线, threads.大墓真相线 }
  reveals: world.殇阳梦境映射机制
  mentions: { world.离公墓志残片, world.殇阳关战牍, world.雷碧城星术残简 }
  render_hint: "三件残证同照才触发梦门，单一物件不能直接入梦。"
}

beat 殷折被映入战前 @ structure.vol01.ch18 {
  effect:
    chars.殷折.位置 = world.殇阳关梦境
    chars.殷折.状态 = 映入战前
    chars.殷折.知道 += world.殇阳梦境映射机制
    world.殇阳梦境残印.状态 = 初显

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.误入地宫线 }
  reveals: world.殇阳梦境映射机制
  mentions: { world.殇阳关梦境, world.殇阳关 }
  render_hint: "入梦要有被证据拖入旧史的压力，不写成自愿施法。"
}

beat 墓主身体压身 @ structure.vol01.ch18 {
  effect:
    chars.殷折.身份 = 梦中墓主映身
    chars.殷折.状态 = 承受墓主因果
    chars.殷折.知道 += world.化身墓主规则
    world.嬴无翳.状态 = 梦中映身

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  pays_off: promises.殇阳梦境伏笔
  advances: { threads.殇阳梦境线, threads.九州野史线, threads.大墓真相线 }
  reveals: world.化身墓主规则
  mentions: { world.嬴无翳, world.离国, world.殇阳关梦境 }
  render_hint: "化身是因果压身，不是获得自由改史的能力。"
}

beat 苏离灯听见旧誓回声 @ structure.vol01.ch18 {
  effect:
    chars.苏离灯.位置 = world.星文回廊
    chars.苏离灯.状态 = 守住梦门外侧
    chars.苏离灯.相信 += "旧誓在殇阳关梦境外回响"
    world.旧鹰扳指.状态 = 梦门外鸣

  pov: chars.苏离灯
  location: world.星文回廊
  on_screen: true
  observers: { chars.苏离灯, chars.牧云镜 }
  advances: { threads.天驱旧誓线, threads.殇阳梦境线 }
  mentions: { world.旧鹰扳指, world.殇阳关梦境, world.天驱旧盟 }
  render_hint: "现实侧仍有苏离灯守门，避免梦境线切断主角团。"
}

beat 梦门合上留限 @ structure.vol01.ch18 {
  effect:
    chars.殷折.知道 += world.梦境挽回边界
    world.殇阳关梦境.状态 = 映射开启
    world.梦中殇阳雨阵.状态 = 待入阵

  pov: chars.殷折
  location: world.殇阳关梦境
  on_screen: true
  observers: { chars.殷折 }
  advances: { threads.殇阳梦境线, threads.摸金门规线 }
  mentions: { world.梦境挽回边界, world.梦中殇阳雨阵 }
  render_hint: "章末要把限制说清：梦境能补名与收殓，不能自由改写战局。"
}
