  location: world.河络地火机坊
  on_screen: true
  observers: { chars.洛衡, chars.殷折 }
  advances: { threads.误入地宫线, threads.大墓真相线 }
  mentions: { world.河络地火机坊, world.河络地火锥, world.河络机坊封死事实 }
  render_hint: "洛衡拆机关是为了留生路，不是为了取走河络旧工。"
}

beat 活人先上旧驿 @ structure.vol01.ch73 {
  effect:
    chars.殷折.状态 = 先护活人
    chars.牧云镜.位置 = world.雪炽原旧驿
    chars.穆如砚.位置 = world.雪炽原旧驿

