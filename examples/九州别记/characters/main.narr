namespace 九州别记.characters

import 九州别记.world as world

class 叙事人物 {
  field 位置: Place = world.无名旧道
  field 所属: Faction
  field 阵营: Symbol = 未定
  field 身份: Symbol = 未明
  field 状态: Symbol = 在场
  field 动机: String = "未明"
  field 秘密: String = "未明"
  field arc_state: Symbol = 未启动
  field 知道: Set<Fact> = {}
  field 相信: Set<Claim> = {}
  field 关系: Set<Claim> = {}
}

character 殷折 : 叙事人物 {
  所属 = world.摸金殷门
  阵营 = 主角团
  身份 = 摸金后人
  状态 = 被迫入局
  动机 = "查清父辈失踪与无名旧道塌陷的关系，并保护同伴活着出地。"
  秘密 = "殷氏祖传罗盘能读出燮朝封陵改制，却会把持有者引向更深墓域。"
  arc_state = 只求脱身
  知道 += world.开局不知大墓
  知道 += world.主角团开局共识
  相信 += "旧陵之物可以看，可以记，不可贪。"
}

character 殷照胆 : 叙事人物 {
  所属 = world.摸金殷门
  阵营 = 祖辈
  身份 = 殷门祖辈
  状态 = 殉门
  动机 = "在最后一次封门活中救出后辈，并把无名旧道的危险留给殷折。"
  秘密 = "他临死前看见的地下石构不是寻常墓门，却没有来得及确认其身份。"
  arc_state = 以死封门
  知道 += world.殷照胆封门旧事
  知道 += world.殷照胆殉门事实
}

character 苏离灯 : 叙事人物 {
  所属 = world.天驱旧盟
  阵营 = 主角团
  身份 = 天驱后裔
  状态 = 隐名随行
  动机 = "确认地下异动是否触犯天驱旧誓，并阻止王道盟约被端朝或辰月利用。"
  秘密 = "她携带的旧鹰扳指并非完整宗主信物，只能证明一支失落天驱曾守过此陵。"
  arc_state = 守誓而疑誓
  知道 += world.天驱人物规划原则
  关系 += "暗中保护殷折"
}

character 牧云镜 : 叙事人物 {
  所属 = world.端室牧云氏
  阵营 = 主角团
  身份 = 牧云旁支史官
  状态 = 奉诏旁观
  动机 = "寻找能解释端朝末局的旧史证据，同时避免牧云氏把墓中真相变成新一轮清洗。"
  秘密 = "她奉的是一份互相矛盾的密诏，一份要取证，一份要灭口。"
  arc_state = 史官两难
  知道 += world.端末盟约破裂
  关系 += "与穆如砚互相提防"
}

character 穆如砚 : 叙事人物 {
  所属 = world.穆如军门
  阵营 = 主角团
  身份 = 穆如军门校尉
  状态 = 押队入边
  动机 = "查明边地塌陷是否牵涉军门旧案，并为被流放的穆如族人争一条活路。"
  秘密 = "他保存着一页穆如先祖关于燮朝封陵的军令抄本。"
  arc_state = 奉命而疑命
  知道 += world.牧云穆如盟约
  知道 += world.端末盟约破裂
}

character 硕风照夜 : 叙事人物 {
  所属 = world.瀚州硕风部
  阵营 = 主角团
  身份 = 瀚州向导
  状态 = 借路同行
  动机 = "追查雪炽原旧歌中失踪的狼旗与无名旧道的关系。"
  秘密 = "她的部族把疑似封陵称为吞狼之口，认为那里埋着会改写草原盟约的东西。"
  arc_state = 为部族问路
  知道 += world.瀚州八部入局
}

character 洛衡 : 叙事人物 {
  所属 = world.摸金殷门
  阵营 = 主角团
  身份 = 机关匠
  状态 = 欠债同行
  动机 = "借殷折的队伍进入旧道，寻找失传的河络机关谱。"
  秘密 = "他已经识出疑似封陵的部分机关不是端朝制式，而是更古老的离国军工。"
  arc_state = 利己到护队
  相信 += "所有机关都有造它的人留下的脾气。"
}

character 闻人观星 : 叙事人物 {
  所属 = world.辰月暗宗
  阵营 = 敌人
  身份 = 辰月教长
  状态 = 暗中布局
  动机 = "把无名旧道变成撬动端朝、军门、天驱和草原诸部互相猜忌的星命局。"
  秘密 = "他并不急于确认墓主，只要各方相信墓中有足以改朝换代的东西。"
  arc_state = 均势操盘
  知道 += world.辰月人物规划原则
  知道 += world.离国辰月牵连
  关系 += "诱导丁缺金背叛殷折"
}

character 姬断鹰 : 叙事人物 {
  所属 = world.天驱旧盟
  阵营 = 敌人
  身份 = 天驱叛宗
  状态 = 追索旧誓
  动机 = "夺回疑似封陵中的旧盟证据，证明天驱可以用霸道恢复王道。"
  秘密 = "他曾是苏离灯一支的护誓人，却认为旧誓已经被软弱者败坏。"
  arc_state = 以誓为狱
  知道 += world.天驱人物规划原则
  关系 += "追杀苏离灯"
}

character 牧云烬 : 叙事人物 {
  所属 = world.端朝掩史司
  阵营 = 敌人
  身份 = 掩史司使
  状态 = 奉密诏封口
  动机 = "控制所有出土文书，确保端朝只得到对牧云氏有利的版本。"
  秘密 = "他知道密诏源头不止一处，牧云氏内部已经把地下发现当成夺权筹码。"
  arc_state = 忠君到灭口
  知道 += world.端朝三百余年
  知道 += world.端末东西分裂
}

character 丁缺金 : 叙事人物 {
  所属 = world.摸金殷门
  阵营 = 敌人
  身份 = 摸金叛徒
  状态 = 伪装同道
  动机 = "先于殷折拿到离公墓志残片，用它向端朝或辰月换取活路。"
  秘密 = "他参与过殷折父辈失踪案，知道殷氏罗盘为何会指向疑似封陵。"
  arc_state = 贪生背门
  知道 += world.开局不知大墓
  关系 += "旧日师兄弟背叛殷折"
}
